{
  "name": "fitmanager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "astro": "astro",
    "build": "astro build",
    "start": "node dist/server/entry.mjs",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "jobs:settle": "tsx scripts/settle.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.13",
    "@astrojs/react": "^7.1.9",
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/astro": "^1.75.0",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "astro": "^7.4.12",
    "better-auth": "^1.7.25",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.75.0",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
