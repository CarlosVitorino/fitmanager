# Production settings for deploy/compose.yml. Copy to deploy/.env (ignored by git) and fill in.

# Public address, exactly as people type it. Better Auth derives cookies and trusted origins from it.
BETTER_AUTH_URL=https://fit.huntingapps.io
# The hostname alone. Baked into the image at build time (Astro trusts the proxy's X-Forwarded-Proto
# for this host only), so changing it needs `up -d --build`.
PUBLIC_HOSTNAME=fit.huntingapps.io

# openssl rand -hex 32  for each. Changing BETTER_AUTH_SECRET signs everyone out.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# How often the settle sidecar runs, in seconds.
SETTLE_EVERY_SECONDS=3600
