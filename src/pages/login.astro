---
import FormError from "../components/FormError.astro";
import Base from "../layouts/Base.astro";
import { auth } from "../lib/auth";
import { readAuthError, redirectWithCookies, safeNext } from "../server/forms";

const next = safeNext(Astro.url.searchParams.get("next"));
let error: string | null = null;
let email = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  email = String(form.get("email") ?? "");
  const res = await auth.api.signInEmail({
    body: { email, password: String(form.get("password") ?? "") },
    headers: Astro.request.headers,
    asResponse: true,
  });
  if (res.ok) return redirectWithCookies(next, res);
  error = await readAuthError(res, "Email or password is incorrect");
  Astro.response.status = res.status;
} else if (Astro.locals.user) {
  return Astro.redirect(next);
}
---

<Base title="Log in">
  <div class="mx-auto max-w-sm space-y-6">
    <h1 class="text-2xl font-semibold">Log in</h1>
    <FormError message={error} />
    <form method="post" class="space-y-4">
      <label class="block space-y-1">
        <span class="text-sm font-medium">Email</span>
        <input
          name="email"
          type="email"
          required
          autocomplete="email"
          value={email}
          class="w-full rounded border border-stone-300 px-3 py-2"
        />
      </label>
      <label class="block space-y-1">
        <span class="text-sm font-medium">Password</span>
        <input
          name="password"
          type="password"
          required
          autocomplete="current-password"
          class="w-full rounded border border-stone-300 px-3 py-2"
        />
      </label>
      <button class="w-full rounded bg-stone-900 px-3 py-2 font-medium text-white hover:bg-stone-700">Log in</button>
    </form>
    <p class="text-sm text-stone-600">
      No account?{" "}
      <a class="underline" href={`/signup?next=${encodeURIComponent(next)}`}>
        Sign up
      </a>
    </p>
  </div>
</Base>
