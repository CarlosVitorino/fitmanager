---
import FormError from "../components/FormError.astro";
import Base from "../layouts/Base.astro";
import { t } from "../i18n";
import { auth } from "../lib/auth";
import { redirectWithCookies, safeNext } from "../server/forms";

const next = safeNext(Astro.url.searchParams.get("next"));
let error: string | null = null;
let email = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  email = String(form.get("email") ?? "");
  const res = await auth.api.signInEmail({
    body: { email, password: String(form.get("password") ?? "") },
    headers: Astro.request.headers,
    asResponse: true,
  });
  if (res.ok) return redirectWithCookies(next, res);
  error = t("auth.loginFailed");
  Astro.response.status = res.status;
} else if (Astro.locals.user) {
  return Astro.redirect(next);
}
---

<Base title={t("auth.loginTitle")} narrow>
  <div class="card space-y-6 p-7">
    <h1 class="text-2xl font-semibold tracking-tight">{t("auth.loginTitle")}</h1>
    <FormError message={error} />
    <form method="post" class="space-y-4">
      <label class="block space-y-1">
        <span class="label">{t("common.email")}</span>
        <input name="email" type="email" required autocomplete="email" value={email} class="input" />
      </label>
      <label class="block space-y-1">
        <span class="label">{t("auth.password")}</span>
        <input name="password" type="password" required autocomplete="current-password" class="input" />
      </label>
      <button class="btn btn-primary w-full py-2.5">{t("auth.loginButton")}</button>
    </form>
    <p class="text-sm text-stone-600">
      {t("auth.noAccount")}{" "}
      <a class="font-medium underline" href={`/signup?next=${encodeURIComponent(next)}`}>
        {t("auth.signupButton")}
      </a>
    </p>
  </div>
</Base>
