---
import FormError from "../../components/FormError.astro";
import Base from "../../layouts/Base.astro";
import { HttpError } from "../../server/errors";
import { t } from "../../i18n";
import { createStudio, createStudioInput } from "../../server/studios";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login?next=/studios/new");

let error: string | null = null;
let values = { name: "", slug: "", timezone: "" };

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  values = {
    name: String(form.get("name") ?? ""),
    slug: String(form.get("slug") ?? ""),
    timezone: String(form.get("timezone") ?? ""),
  };
  const parsed = createStudioInput.safeParse(values);
  if (!parsed.success) {
    error = parsed.error.issues[0]?.message ?? t("errors.checkForm");
    Astro.response.status = 400;
  } else {
    try {
      await createStudio(user.id, parsed.data);
      return Astro.redirect(`/s/${parsed.data.slug}`, 303);
    } catch (e) {
      if (!(e instanceof HttpError)) throw e;
      error = e.message;
      Astro.response.status = e.status;
    }
  }
}

const timezones = Intl.supportedValuesOf("timeZone");
---

<Base title={t("auth.newStudioTitle")} narrow>
  <div class="card space-y-6 p-7">
    <h1 class="text-2xl font-semibold">{t("auth.newStudioTitle")}</h1>
    <FormError message={error} />
    <form method="post" class="space-y-4">
      <label class="block space-y-1">
        <span class="label">{t("auth.studioName")}</span>
        <input name="name" required value={values.name} class="w-full rounded border border-stone-300 px-3 py-2" />
      </label>
      <label class="block space-y-1">
        <span class="label">{t("auth.address")}</span>
        <div class="flex items-center rounded border border-stone-300 bg-white">
          <span class="pl-3 text-stone-500">/s/</span>
          <input
            name="slug"
            required
            value={values.slug}
            pattern="[a-z0-9]+(-[a-z0-9]+)*"
            class="w-full rounded px-1 py-2 outline-none"
          />
        </div>
        <span class="text-xs text-stone-500">{t("auth.addressHint")}</span>
      </label>
      <label class="block space-y-1">
        <span class="label">{t("auth.timezone")}</span>
        <select
          name="timezone"
          required
          id="timezone"
          class="w-full rounded border border-stone-300 bg-white px-3 py-2"
        >
          {timezones.map((tz) => (
            <option value={tz} selected={tz === values.timezone}>
              {tz}
            </option>
          ))}
        </select>
        <span class="text-xs text-stone-500">{t("auth.timezoneHint")}</span>
      </label>
      <button class="w-full rounded bg-stone-900 px-3 py-2 font-medium text-white hover:bg-stone-700">
        {t("auth.createStudioButton")}
      </button>
    </form>
  </div>
  <script>
    const select = document.getElementById("timezone") as HTMLSelectElement | null;
    if (select && !select.querySelector("option[selected]"))
      select.value = Intl.DateTimeFormat().resolvedOptions().timeZone;
  </script>
</Base>
