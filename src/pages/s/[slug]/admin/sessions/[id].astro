---
import BookingControls from "../../../../../components/admin/BookingControls.astro";
import BookingStatus from "../../../../../components/BookingStatus.astro";
import Avatar from "../../../../../components/Avatar.astro";
import ClassBadge from "../../../../../components/ClassBadge.astro";
import Section from "../../../../../components/Section.astro";
import Studio from "../../../../../layouts/Studio.astro";
import { t } from "../../../../../i18n";
import { formatDay, formatDayLong, formatTime, formatTimeRange } from "../../../../../lib/format";
import { handleActions, int, optStr, str } from "../../../../../server/actions";
import { bookingActions } from "../../../../../server/booking-actions";
import { addMemberToSession, cancelSession } from "../../../../../server/bookings";
import { listTemplates } from "../../../../../server/catalog";
import { listMembers } from "../../../../../server/members";
import {
  getSessionDetail,
  listCoaches,
  sessionEditInput,
  updateSession,
  upcomingSessions,
} from "../../../../../server/schedule";

const ctx = Astro.locals.studio!;
const id = Astro.params.id!;

const result = await handleActions(Astro, {
  ...bookingActions(ctx),
  add: async (f) => {
    await addMemberToSession(ctx, id, str(f, "memberId"));
    return t("booking.flash.memberAdded");
  },
  edit: async (f) => {
    await updateSession(
      ctx,
      id,
      sessionEditInput.parse({
        capacity: int(f, "capacity", t("booking.session.spots")),
        coachId: optStr(f, "coachId"),
        templateId: str(f, "templateId"),
      }),
    );
    return t("booking.flash.classUpdated");
  },
  cancelClass: async () => {
    const n = await cancelSession(ctx, id);
    return t("booking.flash.classCancelled", { count: n });
  },
});
if (result instanceof Response) return result;

const s = await getSessionDetail(ctx, id);
const [members, templates, coaches, upcoming] = await Promise.all([
  listMembers(ctx),
  listTemplates(ctx),
  listCoaches(ctx),
  upcomingSessions(ctx),
]);
const started = s.startsAt <= new Date();
const booked = s.roster.filter((r) => r.status === "booked");
const late = s.roster.filter((r) => r.status === "late_cancelled");
const inClass = new Set(booked.map((b) => b.memberId));
const addable = members.filter((m) => m.role === "member" && !inClass.has(m.userId));
const moveTargets = upcoming
  .filter((u) => u.id !== s.id)
  .map((u) => ({
    id: u.id,
    label: `${formatDay(u.localDate)} ${formatTime(u.startsAt, ctx.timezone)} · ${u.templateName} (${u.booked}/${u.capacity})`,
  }));
const base = `/s/${ctx.slug}/admin`;
---

<Studio title={s.templateName} flash={result.flash} error={result.error}>
  <a href={`${base}/calendar?date=${s.localDate}`} class="text-sm text-stone-500 hover:text-stone-900">
    ← {t("booking.session.backToCalendar")}
  </a>
  <div class="card mt-3 mb-6 flex flex-wrap items-start justify-between gap-4 p-5">
    <div>
      <ClassBadge name={s.templateName} color={s.color} icon={s.icon} />
      <h1 class="mt-2 text-2xl font-semibold tracking-tight">
        {formatDayLong(s.localDate)}, {formatTimeRange(s.startsAt, s.endsAt, ctx.timezone)}
      </h1>
      <p class="muted">
        {s.calendarName}
        {s.coachName && ` · ${t("booking.session.withCoach", { name: s.coachName })}`}
      </p>
    </div>
    <div class="text-right">
      <div class="text-3xl font-semibold tabular-nums">
        {booked.length}
        <span class="text-stone-400">/{s.capacity}</span>
      </div>
      <div class="muted">{t("booking.session.spotsTaken")}</div>
      {s.cancelled && <span class="badge mt-1 bg-red-100 text-red-800">{t("booking.session.cancelledBadge")}</span>}
      {!s.cancelled && started && (
        <span class="badge mt-1 bg-stone-900 text-white">{t("booking.session.settled")}</span>
      )}
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-[1fr_20rem]">
    <Section
      title={t("booking.session.rosterTitle")}
      description={started ? t("booking.session.rosterStarted") : t("booking.session.rosterUpcoming")}
    >
      {s.roster.length === 0 && <p class="muted">{t("booking.session.nobody")}</p>}
      <ul class="divide-y divide-stone-100">
        {[...booked, ...late].map((r) => (
          <li class="flex flex-wrap items-center justify-between gap-3 py-3">
            <a href={`${base}/members/${r.memberId}`} class="flex items-center gap-3 hover:underline">
              <Avatar name={r.name} />
              <span>
                <span class="block font-medium">{r.name}</span>
                <BookingStatus status={r.status} charged={r.charged} noShow={r.noShow} settled={r.settledAt !== null} />
              </span>
            </a>
            <BookingControls
              bookingId={r.bookingId}
              status={r.status}
              charged={r.charged}
              noShow={r.noShow}
              started={started}
              moveTargets={moveTargets}
            />
          </li>
        ))}
      </ul>
      {!s.cancelled && addable.length > 0 && (
        <form method="post" class="mt-4 flex gap-2 border-t border-stone-100 pt-4">
          <input type="hidden" name="_action" value="add" />
          <select name="memberId" class="input" aria-label={t("booking.session.memberToAdd")}>
            {addable.map((m) => (
              <option value={m.userId}>
                {t("booking.session.memberCredits", { name: m.name, count: m.available })}
              </option>
            ))}
          </select>
          <button class="btn whitespace-nowrap">{t("booking.session.addMember")}</button>
        </form>
      )}
      {!s.cancelled && <p class="muted mt-2 text-xs">{t("booking.session.staffHint")}</p>}
    </Section>

    <div class="space-y-6">
      {!s.cancelled && (
        <Section title={t("booking.session.thisClassOnly")}>
          <form method="post" class="space-y-3">
            <input type="hidden" name="_action" value="edit" />
            <label class="block space-y-1">
              <span class="label">{t("booking.session.spots")}</span>
              <input name="capacity" type="number" min="1" class="input" value={s.capacity} />
            </label>
            <label class="block space-y-1">
              <span class="label">{t("booking.session.classType")}</span>
              <select name="templateId" class="input">
                {templates.map((tpl) => (
                  <option value={tpl.id} selected={tpl.id === s.templateId}>
                    {tpl.icon} {tpl.name}
                  </option>
                ))}
              </select>
            </label>
            <label class="block space-y-1">
              <span class="label">{t("booking.session.coach")}</span>
              <select name="coachId" class="input">
                <option value="">{t("booking.session.noCoach")}</option>
                {coaches.map((c) => (
                  <option value={c.id} selected={c.id === s.coachId}>
                    {c.name}
                  </option>
                ))}
              </select>
            </label>
            <button class="btn w-full">{t("common.save")}</button>
          </form>
        </Section>
      )}
      {!s.cancelled && !started && (
        <form method="post" class="card p-5">
          <p class="muted mb-3">{t("booking.session.cancelHint")}</p>
          <button
            class="btn btn-danger w-full"
            name="_action"
            value="cancelClass"
            onclick={`return confirm(${JSON.stringify(t("booking.session.cancelConfirm"))})`}
          >
            {t("booking.session.cancelClass")}
          </button>
        </form>
      )}
    </div>
  </div>
</Studio>
