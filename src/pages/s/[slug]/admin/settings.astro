---
import { CalendarClock, Link2, Store } from "@lucide/astro";
import Section from "../../../../components/Section.astro";
import Setup from "../../../../layouts/Setup.astro";
import { t } from "../../../../i18n";
import { LOCALES, LOCALE_NAMES } from "../../../../i18n/locales";
import { formatMinutes } from "../../../../lib/format";
import { handleActions, int, str } from "../../../../server/actions";
import { getSettings, regenerateJoinCode, settingsInput, updateSettings } from "../../../../server/members";
import { requireCapability } from "../../../../server/studio-context";

const ctx = Astro.locals.studio!;
requireCapability(ctx, "studio:settings");

const result = await handleActions(Astro, {
  save: async (f) => {
    await updateSettings(
      ctx,
      settingsInput.parse({
        name: str(f, "name"),
        timezone: str(f, "timezone"),
        currency: str(f, "currency").toUpperCase(),
        locale: str(f, "locale"),
        bookingCutoffMinutes: Math.round(Number(str(f, "bookingCutoffHours")) * 60),
        cancellationCutoffMinutes: int(f, "cancellationCutoffHours", t("setup.settings.freeCancellation")) * 60,
      }),
    );
    return t("setup.settings.saved");
  },
  regenerate: async () => {
    await regenerateJoinCode(ctx);
    return t("setup.settings.newLinkDone");
  },
});
if (result instanceof Response) return result;

const settings = await getSettings(ctx);
const inviteUrl = new URL(`/join/${ctx.slug}/${settings.joinCode}`, Astro.url).toString();
const timezones = Intl.supportedValuesOf("timeZone");
---

<Setup
  title={t("setup.settings.title")}
  subtitle={t("setup.settings.subtitle")}
  flash={result.flash}
  error={result.error}
>
  <div class="max-w-3xl space-y-6">
    <form method="post" class="space-y-6">
      <input type="hidden" name="_action" value="save" />
      <Section title={t("setup.settings.studio")}>
        <Store slot="icon" size={18} />
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block space-y-1 sm:col-span-2">
            <span class="label">{t("setup.settings.studioName")}</span>
            <input name="name" required class="input" value={ctx.name} />
          </label>
          <label class="block space-y-1">
            <span class="label">{t("setup.settings.defaultLanguage")}</span>
            <select name="locale" class="input">
              {LOCALES.map((l) => (
                <option value={l} selected={l === settings.locale}>
                  {LOCALE_NAMES[l]}
                </option>
              ))}
            </select>
            <span class="block text-xs text-stone-500">{t("setup.settings.defaultLanguageHint")}</span>
          </label>
          <label class="block space-y-1">
            <span class="label">{t("setup.settings.currency")}</span>
            <input name="currency" required maxlength="3" class="input uppercase" value={settings.currency} />
          </label>
          <label class="block space-y-1 sm:col-span-2">
            <span class="label">{t("setup.settings.timezone")}</span>
            <select name="timezone" class="input">
              {timezones.map((tz) => (
                <option value={tz} selected={tz === settings.timezone}>
                  {tz}
                </option>
              ))}
            </select>
          </label>
        </div>
      </Section>

      <Section title={t("setup.settings.bookingRules")}>
        <CalendarClock slot="icon" size={18} />
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block space-y-1">
            <span class="label">{t("setup.settings.bookingCloses")}</span>
            <div class="flex items-center gap-2">
              <input
                name="bookingCutoffHours"
                type="number"
                min="0"
                step="0.5"
                class="input w-24"
                value={settings.bookingCutoffMinutes / 60}
              />
              <span class="muted whitespace-nowrap">{t("setup.settings.hoursBefore")}</span>
            </div>
          </label>
          <label class="block space-y-1">
            <span class="label">{t("setup.settings.freeCancellation")}</span>
            <div class="flex items-center gap-2">
              <input
                name="cancellationCutoffHours"
                type="number"
                min="0"
                class="input w-24"
                value={settings.cancellationCutoffMinutes / 60}
              />
              <span class="muted whitespace-nowrap">{t("setup.settings.hoursBefore")}</span>
            </div>
          </label>
        </div>
        <p class="mt-4 rounded-xl bg-stone-50 p-3.5 text-sm text-stone-600">
          {t("setup.settings.rulesSummary", {
            booking: formatMinutes(settings.bookingCutoffMinutes),
            cancel: formatMinutes(settings.cancellationCutoffMinutes),
          })}
        </p>
      </Section>

      <div class="flex justify-end">
        <button class="btn btn-primary">{t("setup.settings.saveSettings")}</button>
      </div>
    </form>

    <Section title={t("setup.settings.invite")} description={t("setup.settings.inviteHint")} id="invite">
      <Link2 slot="icon" size={18} />
      <div class="flex gap-2">
        <input readonly class="input font-mono text-xs" value={inviteUrl} id="invite-url" onclick="this.select()" />
        <button
          type="button"
          class="btn"
          data-copied={t("common.copied")}
          onclick="navigator.clipboard.writeText(document.getElementById('invite-url').value);this.textContent=this.dataset.copied"
        >
          {t("common.copy")}
        </button>
      </div>
      <form method="post" class="mt-4 flex flex-wrap items-center gap-2">
        <button
          class="btn btn-sm"
          name="_action"
          value="regenerate"
          onclick={`return confirm(${JSON.stringify(t("setup.settings.newLinkConfirm"))})`}
        >
          {t("setup.settings.newLink")}
        </button>
        <span class="muted">{t("setup.settings.newLinkHint")}</span>
      </form>
    </Section>
  </div>
</Setup>
