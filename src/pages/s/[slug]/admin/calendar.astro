---
import { Plus, X } from "@lucide/astro";
import ClassCalendar from "../../../../components/islands/ClassCalendar";
import { getLocale, messagesFor, t } from "../../../../i18n";
import DateInput from "../../../../components/DateInput.astro";
import TimeField from "../../../../components/TimeField.astro";
import Studio from "../../../../layouts/Studio.astro";
import { addDays, isLocalDate, localDateOf } from "../../../../domain/dates";
import { handleActions, int, optStr, str } from "../../../../server/actions";
import { listCalendars, listTemplates } from "../../../../server/catalog";
import {
  createOneOffSession,
  listCoaches,
  listSessions,
  oneOffInput,
  toCalendarSessions,
} from "../../../../server/schedule";

const ctx = Astro.locals.studio!;
const today = localDateOf(new Date(), ctx.timezone);
const dateParam = Astro.url.searchParams.get("date") ?? Astro.url.searchParams.get("week");
const selectedDate = dateParam && isLocalDate(dateParam) ? dateParam : today;
const calendarId = Astro.url.searchParams.get("calendar") || undefined;

const result = await handleActions(Astro, {
  oneOff: async (f) => {
    const s = await createOneOffSession(
      ctx,
      oneOffInput.parse({
        calendarId: str(f, "calendarId"),
        templateId: str(f, "templateId"),
        date: str(f, "date"),
        startTime: str(f, "startTime"),
        durationMinutes: int(f, "durationMinutes", t("booking.calendar.minutes")),
        capacity: int(f, "capacity", t("booking.calendar.spots")),
        coachId: optStr(f, "coachId"),
      }),
    );
    return Astro.redirect(`/s/${ctx.slug}/admin/sessions/${s.id}`, 303);
  },
});
if (result instanceof Response) return result;

const rangeFrom = addDays(selectedDate, -42);
const rangeTo = addDays(selectedDate, 70);
const [sessions, calendars, templates, coaches] = await Promise.all([
  // A generous window around the visible date; navigating further reloads the page with ?date=.
  listSessions(ctx, rangeFrom, rangeTo, { calendarId, includeCancelled: true }),
  listCalendars(ctx),
  listTemplates(ctx),
  listCoaches(ctx),
]);
const link = (cal?: string) => `?${new URLSearchParams({ ...(cal ? { calendar: cal } : {}), date: selectedDate })}`;
const base = `/s/${ctx.slug}/admin`;
---

<Studio title={t("booking.calendar.title")} flash={result.flash} error={result.error} wide>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight">{t("booking.calendar.title")}</h1>
      <p class="muted">
        {t("booking.calendar.intro")}{" "}
        <a class="underline" href={`${base}/calendars`}>
          {t("booking.calendar.introLink")}
        </a>
        .
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-1">
      <a href={link()} class:list={["btn btn-sm", !calendarId && "btn-primary"]}>
        {t("booking.calendar.allCalendars")}
      </a>
      {calendars.map((c) => (
        <a href={link(c.id)} class:list={["btn btn-sm", calendarId === c.id && "btn-primary"]}>
          {c.name}
        </a>
      ))}
      <button
        type="button"
        class="btn btn-sm btn-primary ml-2"
        onclick="document.getElementById('one-off').showModal()"
        title={t("booking.calendar.oneOff")}
      >
        <Plus size={15} /> {t("booking.calendar.oneOffShort")}
      </button>
    </div>
  </div>

  <ClassCalendar
    client:only="react"
    mode="coach"
    sessions={toCalendarSessions(sessions)}
    timezone={ctx.timezone}
    today={today}
    selectedDate={selectedDate}
    rangeFrom={rangeFrom}
    rangeTo={rangeTo}
    sessionBaseUrl={`${base}/sessions`}
    bookingCutoffMinutes={ctx.bookingCutoffMinutes}
    cancellationCutoffMinutes={ctx.cancellationCutoffMinutes}
    locale={getLocale()}
    messages={messagesFor("booking")}
  />

  <dialog
    id="one-off"
    class="m-auto w-[min(36rem,calc(100vw-2rem))] overflow-visible rounded-2xl bg-white p-6 text-stone-900 shadow-2xl backdrop:bg-stone-900/40"
  >
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-lg font-semibold">{t("booking.calendar.oneOff")}</h2>
        <p class="muted mt-1">{t("booking.calendar.oneOffHint")}</p>
      </div>
      <form method="dialog">
        <button class="rounded-lg p-1.5 text-stone-500 hover:bg-stone-100" aria-label={t("common.close")}>
          <X size={18} />
        </button>
      </form>
    </div>
    <form method="post" class="mt-5 grid grid-cols-2 gap-3">
      <input type="hidden" name="_action" value="oneOff" />
      <label class="block space-y-1">
        <span class="label">{t("booking.calendar.calendarLabel")}</span>
        <select name="calendarId" class="input">
          {calendars.map((c) => (
            <option value={c.id} selected={c.id === calendarId}>
              {c.name}
            </option>
          ))}
        </select>
      </label>
      <label class="block space-y-1">
        <span class="label">{t("booking.session.classType")}</span>
        <select name="templateId" class="input">
          {templates.map((tpl) => (
            <option value={tpl.id}>
              {tpl.icon} {tpl.name}
            </option>
          ))}
        </select>
      </label>
      <div class="space-y-1">
        <span class="label">{t("booking.calendar.date")}</span>
        <DateInput
          name="date"
          value={selectedDate < today ? today : selectedDate}
          today={today}
          min={today}
          required
          ariaLabel={t("booking.calendar.date")}
        />
      </div>
      <div class="space-y-1">
        <span class="label">{t("booking.calendar.startsAt")}</span>
        <TimeField name="startTime" value="18:00" label={t("booking.calendar.startsAt")} />
      </div>
      <label class="block space-y-1">
        <span class="label">{t("booking.calendar.minutes")}</span>
        <input name="durationMinutes" type="number" min="5" required class="input" value="60" />
      </label>
      <label class="block space-y-1">
        <span class="label">{t("booking.calendar.spots")}</span>
        <input name="capacity" type="number" min="1" required class="input" value="1" />
      </label>
      <label class="col-span-2 block space-y-1">
        <span class="label">{t("booking.session.coach")}</span>
        <select name="coachId" class="input">
          <option value="">{t("booking.session.noCoach")}</option>
          {coaches.map((c) => (
            <option value={c.id} selected={c.id === ctx.userId}>
              {c.name}
            </option>
          ))}
        </select>
      </label>
      <button class="btn btn-primary col-span-2">{t("booking.calendar.addClass")}</button>
    </form>
  </dialog>
</Studio>
