---
import PlanFields from "../../../../components/admin/PlanFields.astro";
import Studio from "../../../../layouts/Studio.astro";
import { describeValidity } from "../../../../domain/packs";
import { formatMoney, plural } from "../../../../lib/format";
import { handleActions, int, money, optInt, optStr, str } from "../../../../server/actions";
import { archivePackType, listPackTypes, packTypeInput, savePackType } from "../../../../server/catalog";
import { requireCapability } from "../../../../server/studio-context";
import { validityOf } from "../../../../server/packs";

const ctx = Astro.locals.studio!;
requireCapability(ctx, "studio:settings");

const parse = (f: FormData) => {
  const amount = optInt(f, "validityAmount", "duration");
  const unit = amount === null ? "never" : str(f, "validityUnit");
  return packTypeInput.parse({
    name: str(f, "name"),
    description: optStr(f, "description"),
    entries: int(f, "entries", "classes"),
    validityUnit: unit === "never" ? null : unit,
    validityAmount: unit === "never" ? null : amount,
    priceCents: money(f, "price"),
  });
};

const result = await handleActions(Astro, {
  create: async (f) => {
    await savePackType(ctx, parse(f));
    return "Plan added.";
  },
  update: async (f) => {
    await savePackType(ctx, parse(f), str(f, "id"));
    return "Plan saved.";
  },
  archive: async (f) => {
    await archivePackType(ctx, str(f, "id"), true);
    return "Plan hidden. Members who hold it keep their credits.";
  },
  restore: async (f) => {
    await archivePackType(ctx, str(f, "id"), false);
    return "Plan restored.";
  },
});
if (result instanceof Response) return result;

const plans = await listPackTypes(ctx, { includeArchived: true });
const editId = Astro.url.searchParams.get("edit");
---

<Studio title="Plans" flash={result.flash} error={result.error}>
  <a href={`/s/${ctx.slug}/admin/setup`} class="muted hover:underline">
    ← Setup
  </a>
  <h1 class="mt-1 mb-1 text-2xl font-semibold">Plans</h1>
  <p class="muted mb-6">
    The plans you assign to members. Changing a plan only affects plans assigned after the change.
  </p>

  <div class="grid gap-6 lg:grid-cols-[1fr_22rem]">
    <div class="space-y-3">
      {plans.map((p) =>
        editId === p.id ? (
          <form method="post" class="card space-y-3 p-5">
            <input type="hidden" name="_action" value="update" />
            <input type="hidden" name="id" value={p.id} />
            <input type="hidden" name="_redirect" value={Astro.url.pathname} />
            <PlanFields plan={p} currency={ctx.currency} />
            <div class="flex gap-2">
              <button class="btn btn-primary">Save</button>
              <a href={Astro.url.pathname} class="btn">
                Cancel
              </a>
            </div>
          </form>
        ) : (
          <div
            class:list={["card flex flex-wrap items-center justify-between gap-4 p-5", p.archivedAt && "opacity-60"]}
          >
            <div>
              <div class="flex items-center gap-2">
                <span class="font-semibold">{p.name}</span>
                {p.archivedAt && <span class="badge bg-stone-100 text-stone-600">Hidden</span>}
              </div>
              <div class="muted mt-1">
                {plural(p.entries, "class", "classes")} · {describeValidity(validityOf(p))} ·{" "}
                {formatMoney(p.priceCents, ctx.currency)}
              </div>
              {p.description && <p class="mt-1 text-sm text-stone-600">{p.description}</p>}
            </div>
            <div class="flex gap-2">
              <a href={`?edit=${p.id}`} class="btn btn-sm">
                Edit
              </a>
              <form method="post">
                <input type="hidden" name="id" value={p.id} />
                <button class="btn btn-sm" name="_action" value={p.archivedAt ? "restore" : "archive"}>
                  {p.archivedAt ? "Restore" : "Hide"}
                </button>
              </form>
            </div>
          </div>
        ),
      )}
    </div>

    <form method="post" class="card h-fit space-y-3 p-5">
      <h2 class="h2">Add a plan</h2>
      <input type="hidden" name="_action" value="create" />
      <PlanFields currency={ctx.currency} />
      <button class="btn btn-primary w-full">Add plan</button>
    </form>
  </div>
</Studio>
