---
import ClassBadge from "../../../../components/ClassBadge.astro";
import TemplateFields from "../../../../components/admin/TemplateFields.astro";
import Studio from "../../../../layouts/Studio.astro";
import { handleActions, optStr, str } from "../../../../server/actions";
import { archiveTemplate, listTemplates, saveTemplate, templateInput } from "../../../../server/catalog";

const ctx = Astro.locals.studio!;
const parse = (f: FormData) =>
  templateInput.parse({
    name: str(f, "name"),
    description: optStr(f, "description"),
    color: str(f, "color"),
    icon: str(f, "icon"),
  });

const result = await handleActions(Astro, {
  create: async (f) => {
    await saveTemplate(ctx, parse(f));
    return "Class type added.";
  },
  update: async (f) => {
    await saveTemplate(ctx, parse(f), str(f, "id"));
    return "Class type saved.";
  },
  archive: async (f) => {
    await archiveTemplate(ctx, str(f, "id"), true);
    return "Class type hidden. Existing classes keep it.";
  },
  restore: async (f) => {
    await archiveTemplate(ctx, str(f, "id"), false);
    return "Class type restored.";
  },
});
if (result instanceof Response) return result;

const templates = await listTemplates(ctx, { includeArchived: true });
const editId = Astro.url.searchParams.get("edit");
---

<Studio title="Class types" flash={result.flash} error={result.error}>
  <a href={`/s/${ctx.slug}/admin/setup`} class="muted hover:underline">
    ← Setup
  </a>
  <h1 class="mt-1 mb-1 text-2xl font-semibold">Class types</h1>
  <p class="muted mb-6">Give classes their own name, colour and icon so members can tell them apart in the calendar.</p>

  <div class="grid gap-6 lg:grid-cols-[1fr_22rem]">
    <div class="space-y-3">
      {templates.map((t) =>
        editId === t.id ? (
          <form method="post" class="card space-y-4 p-5">
            <input type="hidden" name="_action" value="update" />
            <input type="hidden" name="id" value={t.id} />
            <input type="hidden" name="_redirect" value={Astro.url.pathname} />
            <TemplateFields template={t} idPrefix={t.id} />
            <div class="flex gap-2">
              <button class="btn btn-primary">Save</button>
              <a href={Astro.url.pathname} class="btn">
                Cancel
              </a>
            </div>
          </form>
        ) : (
          <div
            class:list={["card flex items-center justify-between gap-4 border-l-4 p-4", t.archivedAt && "opacity-60"]}
            style={`border-left-color:${t.color}`}
          >
            <div>
              <div class="flex items-center gap-2">
                <ClassBadge name={t.name} color={t.color} icon={t.icon} />
                {t.isDefault && <span class="badge bg-stone-100 text-stone-600">Default</span>}
                {t.archivedAt && <span class="badge bg-stone-100 text-stone-600">Hidden</span>}
              </div>
              {t.description && <p class="mt-1 ml-9 text-sm text-stone-600">{t.description}</p>}
            </div>
            <div class="flex gap-2">
              <a href={`?edit=${t.id}`} class="btn btn-sm">
                Edit
              </a>
              {!t.isDefault && (
                <form method="post">
                  <input type="hidden" name="id" value={t.id} />
                  <button class="btn btn-sm" name="_action" value={t.archivedAt ? "restore" : "archive"}>
                    {t.archivedAt ? "Restore" : "Hide"}
                  </button>
                </form>
              )}
            </div>
          </div>
        ),
      )}
    </div>
    <form method="post" class="card h-fit space-y-4 p-5">
      <h2 class="h2">Add a class type</h2>
      <input type="hidden" name="_action" value="create" />
      <TemplateFields idPrefix="new" />
      <button class="btn btn-primary w-full">Add class type</button>
    </form>
  </div>
</Studio>
