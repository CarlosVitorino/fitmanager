---
import Studio from "../../../../../layouts/Studio.astro";
import { handleActions, optStr, str } from "../../../../../server/actions";
import { calendarInput, listCalendars, saveCalendar } from "../../../../../server/catalog";
import { db } from "../../../../../db/client";
import { slot } from "../../../../../db/schema";
import { and, eq, isNull, or, gte, sql } from "drizzle-orm";
import { localDateOf } from "../../../../../domain/dates";

const ctx = Astro.locals.studio!;
const result = await handleActions(Astro, {
  create: async (f) => {
    const cal = await saveCalendar(
      ctx,
      calendarInput.parse({ name: str(f, "name"), description: optStr(f, "description") }),
    );
    return Astro.redirect(`/s/${ctx.slug}/admin/calendars/${cal.id}`, 303);
  },
});
if (result instanceof Response) return result;

const calendars = await listCalendars(ctx);
const today = localDateOf(new Date(), ctx.timezone);
const counts = await db
  .select({ calendarId: slot.calendarId, n: sql<number>`count(*)::int` })
  .from(slot)
  .where(and(eq(slot.studioId, ctx.studioId), or(isNull(slot.endsOn), gte(slot.endsOn, today))))
  .groupBy(slot.calendarId);
const slotCount = new Map(counts.map((c) => [c.calendarId, c.n]));
---

<Studio title="Calendars" flash={result.flash} error={result.error}>
  <a href={`/s/${ctx.slug}/admin/setup`} class="muted hover:underline">
    ← Setup
  </a>
  <h1 class="mt-1 mb-1 text-2xl font-semibold">Calendars</h1>
  <p class="muted mb-6">Each calendar has its own weekly slots. Members can filter by calendar when booking.</p>
  <div class="grid gap-6 lg:grid-cols-[1fr_22rem]">
    <div class="space-y-3">
      {calendars.map((c) => (
        <a
          href={`/s/${ctx.slug}/admin/calendars/${c.id}`}
          class="card flex items-center justify-between p-5 hover:border-stone-400"
        >
          <span>
            <span class="font-semibold">{c.name}</span>
            {c.description && <span class="muted block">{c.description}</span>}
          </span>
          <span class="muted">{slotCount.get(c.id) ?? 0} weekly slots →</span>
        </a>
      ))}
    </div>
    <form method="post" class="card h-fit space-y-3 p-5">
      <h2 class="h2">Add a calendar</h2>
      <input type="hidden" name="_action" value="create" />
      <label class="block space-y-1">
        <span class="label">Name</span>
        <input name="name" required class="input" placeholder="e.g. Outdoor bootcamp" />
      </label>
      <label class="block space-y-1">
        <span class="label">Description</span>
        <input name="description" class="input" />
      </label>
      <button class="btn btn-primary w-full">Add calendar</button>
    </form>
  </div>
</Studio>
