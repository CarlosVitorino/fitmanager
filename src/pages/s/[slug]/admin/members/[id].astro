---
import BookingControls from "../../../../../components/admin/BookingControls.astro";
import BookingStatus from "../../../../../components/BookingStatus.astro";
import PackCard from "../../../../../components/PackCard.astro";
import Section from "../../../../../components/Section.astro";
import Studio from "../../../../../layouts/Studio.astro";
import { localDateOf } from "../../../../../domain/dates";
import { describeValidity } from "../../../../../domain/packs";
import {
  formatDate,
  formatDay,
  formatInstant,
  formatMoney,
  formatTime,
  initials,
  plural,
} from "../../../../../lib/format";
import { handleActions, int, money, optStr, str } from "../../../../../server/actions";
import { can, isRole } from "../../../../../server/authz";
import { bookingActions } from "../../../../../server/booking-actions";
import { listPackTypes } from "../../../../../server/catalog";
import { badRequest } from "../../../../../server/errors";
import {
  addNote,
  classHistory,
  deleteNote,
  deletePayment,
  getMember,
  listNotes,
  listPayments,
  memberAchievements,
  memberAudit,
  noteInput,
  profileInput,
  recordPayment,
  setRole,
  updateNote,
  updateProfile,
} from "../../../../../server/members";
import { adjustCredits, assignPlan, memberPacks, validityOf } from "../../../../../server/packs";
import { upcomingSessions } from "../../../../../server/schedule";
import { PAYMENT_METHODS } from "../../../../../db/schema";

const ctx = Astro.locals.studio!;
const memberId = Astro.params.id!;
const today = localDateOf(new Date(), ctx.timezone);

const result = await handleActions(Astro, {
  ...bookingActions(ctx),
  assign: async (f) => {
    const amount = money(f, "amount");
    await assignPlan(ctx, {
      memberId,
      packTypeId: str(f, "packTypeId"),
      startsOn: str(f, "startsOn"),
      note: optStr(f, "note") ?? undefined,
      payment:
        amount !== null
          ? {
              amountCents: amount,
              method: str(f, "method") as (typeof PAYMENT_METHODS)[number],
              paidOn: str(f, "paidOn") || today,
            }
          : undefined,
    });
    return amount !== null ? "Plan added and payment recorded." : "Plan added.";
  },
  adjust: async (f) => {
    const n = int(f, "amount", "credits");
    const delta = str(f, "direction") === "remove" ? -n : n;
    await adjustCredits(ctx, { packId: str(f, "packId"), delta, reason: str(f, "reason") });
    return `${delta > 0 ? "Added" : "Removed"} ${plural(Math.abs(delta), "credit")}.`;
  },
  note: async (f) => {
    await addNote(ctx, memberId, noteInput.parse({ body: str(f, "body"), visibility: str(f, "visibility") }));
    return "Note saved.";
  },
  editNote: async (f) => {
    await updateNote(
      ctx,
      str(f, "noteId"),
      noteInput.parse({ body: str(f, "body"), visibility: str(f, "visibility") }),
    );
    return "Note saved.";
  },
  deleteNote: async (f) => {
    await deleteNote(ctx, str(f, "noteId"));
    return "Note deleted.";
  },
  payment: async (f) => {
    const amount = money(f, "amount");
    if (amount === null) throw badRequest("Enter the amount paid");
    await recordPayment(ctx, memberId, {
      amountCents: amount,
      method: str(f, "method") as (typeof PAYMENT_METHODS)[number],
      paidOn: str(f, "paidOn") || today,
      note: optStr(f, "note") ?? undefined,
      packId: optStr(f, "packId"),
    });
    return "Payment recorded.";
  },
  deletePayment: async (f) => {
    await deletePayment(ctx, str(f, "paymentId"));
    return "Payment deleted.";
  },
  profile: async (f) => {
    await updateProfile(ctx, memberId, profileInput.parse({ name: str(f, "name"), phone: str(f, "phone") }));
    return "Profile saved.";
  },
  role: async (f) => {
    const role = str(f, "role");
    if (!isRole(role)) throw badRequest("Unknown role");
    await setRole(ctx, memberId, role);
    return "Role changed.";
  },
});
if (result instanceof Response) return result;

const [m, packs, history, notes, payments, plans, log, upcomingAll] = await Promise.all([
  getMember(ctx, memberId),
  memberPacks(ctx, memberId),
  classHistory(ctx, memberId),
  listNotes(ctx, memberId),
  listPayments(ctx, { memberId }),
  listPackTypes(ctx),
  memberAudit(ctx, memberId),
  upcomingSessions(ctx),
]);
const a = memberAchievements(ctx, history);
const now = new Date();
const upcoming = history.filter((h) => h.status === "booked" && h.startsAt > now && !h.sessionCancelled).reverse();
const past = history.filter((h) => !(h.status === "booked" && h.startsAt > now && !h.sessionCancelled));
const current = packs.filter((p) => p.status === "active" || p.status === "upcoming");
const old = packs.filter((p) => p.status === "expired" || p.status === "used_up");
const credits = current.reduce((n, p) => n + p.available, 0);
const totalPaid = payments.reduce((n, p) => n + p.amountCents, 0);
const canCredits = can(ctx.role, "credits:manage");
const editingNote = Astro.url.searchParams.get("note");
const tab = Astro.url.searchParams.get("tab") ?? "plans";
const moveTargets = (sessionId: string) =>
  upcomingAll
    .filter((u) => u.id !== sessionId)
    .map((u) => ({
      id: u.id,
      label: `${formatDay(u.localDate)} ${formatTime(u.startsAt, ctx.timezone)} · ${u.templateName} (${u.booked}/${u.capacity})`,
    }));
const auditText: Record<string, (d: Record<string, unknown>) => string> = {
  "plan.assigned": (d) =>
    `Added plan ${d.plan} (${d.entries} credits)${d.paymentCents != null ? `, paid ${formatMoney(d.paymentCents as number, ctx.currency)}` : ""}`,
  "credits.adjusted": (d) =>
    `${(d.delta as number) > 0 ? "Added" : "Removed"} ${Math.abs(d.delta as number)} on ${d.pack}: “${d.reason}”`,
  "booking.added": () => "Booked into a class by staff",
  "booking.removed": () => "Booking removed, credit returned",
  "booking.moved": () => "Booking moved to another class",
  "booking.charge_changed": (d) => (d.charged ? "Credit charged for a booking" : "Credit waived for a booking"),
  "booking.no_show_changed": (d) => (d.noShow ? "Marked as no-show" : "No-show removed"),
  "member.role_changed": (d) => `Role changed from ${d.from} to ${d.to}`,
  "payment.recorded": (d) => `Payment recorded: ${formatMoney(d.amountCents as number, ctx.currency)}`,
  "payment.deleted": (d) => `Payment deleted: ${formatMoney(d.amountCents as number, ctx.currency)} from ${d.paidOn}`,
};
const tabs = [
  ["plans", "Plans & credits"],
  ["classes", `Classes (${history.length})`],
  ["notes", `Notes (${notes.length})`],
  ["payments", `Payments (${payments.length})`],
  ["activity", "Activity"],
] as const;
---

<Studio title={m.name} flash={result.flash} error={result.error}>
  <a href={`/s/${ctx.slug}/admin/members`} class="muted hover:underline">
    ← Members
  </a>
  <div class="mt-2 mb-6 flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-4">
      <span class="flex h-14 w-14 items-center justify-center rounded-full bg-stone-900 text-lg font-semibold text-white">
        {initials(m.name)}
      </span>
      <div>
        <h1 class="flex items-center gap-2 text-2xl font-semibold">
          {m.name} {m.role !== "member" && <span class="badge bg-stone-900 text-white capitalize">{m.role}</span>}
        </h1>
        <p class="muted">
          {m.email}
          {m.phone && ` · ${m.phone}`} · member since {formatDate(localDateOf(m.joinedAt, ctx.timezone))}
        </p>
      </div>
    </div>
    <div class="flex gap-6 text-center">
      <div>
        <div class="text-2xl font-semibold tabular-nums">{credits}</div>
        <div class="muted text-xs">credits free</div>
      </div>
      <div>
        <div class="text-2xl font-semibold tabular-nums">{a.totalClasses}</div>
        <div class="muted text-xs">classes done</div>
      </div>
      <div>
        <div class="text-2xl font-semibold tabular-nums">{a.currentStreakWeeks}🔥</div>
        <div class="muted text-xs">week streak</div>
      </div>
      <div>
        <div class="text-2xl font-semibold tabular-nums">{upcoming.length}</div>
        <div class="muted text-xs">booked</div>
      </div>
    </div>
  </div>

  <nav class="mb-5 flex gap-1 overflow-x-auto border-b border-stone-200">
    {tabs.map(([key, label]) => (
      <a
        href={`?tab=${key}`}
        class:list={[
          "-mb-px border-b-2 px-3 py-2 text-sm font-medium whitespace-nowrap",
          tab === key ? "border-stone-900 text-stone-900" : "border-transparent text-stone-500 hover:text-stone-800",
        ]}
      >
        {label}
      </a>
    ))}
  </nav>

  {tab === "plans" && (
    <div class="grid gap-6 lg:grid-cols-[1fr_22rem]">
      <div class="space-y-6">
        <Section title="Current plans" description="Credits are spent from the plan closest to expiry first.">
          {current.length === 0 && <p class="muted">No active plan.</p>}
          <div class="grid gap-3 sm:grid-cols-2">
            {current.map((p) => (
              <PackCard pack={p} timezone={ctx.timezone}>
                {canCredits && (
                  <details class="mt-3 border-t border-stone-100 pt-3">
                    <summary class="cursor-pointer text-sm font-medium text-stone-700">Adjust credits</summary>
                    <form method="post" class="mt-2 space-y-2">
                      <input type="hidden" name="_action" value="adjust" />
                      <input type="hidden" name="packId" value={p.id} />
                      <div class="flex gap-2">
                        <select name="direction" class="input w-28">
                          <option value="add">Add</option>
                          <option value="remove">Remove</option>
                        </select>
                        <input name="amount" type="number" min="1" value="1" class="input w-20" aria-label="Credits" />
                      </div>
                      <input
                        name="reason"
                        required
                        minlength="3"
                        placeholder="Reason (kept in the history)"
                        class="input"
                      />
                      <button class="btn btn-sm w-full">Save adjustment</button>
                    </form>
                  </details>
                )}
              </PackCard>
            ))}
          </div>
          {old.length > 0 && (
            <details class="mt-4">
              <summary class="muted cursor-pointer">Past plans ({old.length})</summary>
              <div class="mt-3 grid gap-3 sm:grid-cols-2">
                {old.map((p) => (
                  <PackCard pack={p} timezone={ctx.timezone} />
                ))}
              </div>
            </details>
          )}
        </Section>

        <Section title="Upcoming classes">
          {upcoming.length === 0 && <p class="muted">Nothing booked.</p>}
          <ul class="divide-y divide-stone-100">
            {upcoming.map((h) => (
              <li class="flex flex-wrap items-center justify-between gap-2 py-2.5 text-sm">
                <a href={`/s/${ctx.slug}/admin/sessions/${h.sessionId}`} class="hover:underline">
                  <span class="font-medium">
                    {formatDay(h.localDate)} · {formatTime(h.startsAt, ctx.timezone)}
                  </span>
                  <span class="ml-2" style={`color:${h.color}`}>
                    {h.icon} {h.templateName}
                  </span>
                  <span class="muted block text-xs">{h.packName}</span>
                </a>
                <BookingControls
                  bookingId={h.bookingId}
                  status={h.status}
                  charged={h.charged}
                  noShow={h.noShow}
                  started={false}
                  moveTargets={moveTargets(h.sessionId)}
                />
              </li>
            ))}
          </ul>
        </Section>
      </div>

      {canCredits && (
        <form method="post" class="card h-fit space-y-3 p-5">
          <h2 class="h2">Add a plan</h2>
          <input type="hidden" name="_action" value="assign" />
          <label class="block space-y-1">
            <span class="label">Plan</span>
            <select name="packTypeId" class="input">
              {plans.map((p) => (
                <option value={p.id}>
                  {p.name} · {plural(p.entries, "class", "classes")} · {describeValidity(validityOf(p)).toLowerCase()}
                </option>
              ))}
            </select>
          </label>
          <label class="block space-y-1">
            <span class="label">Starts on</span>
            <input name="startsOn" type="date" required value={today} class="input" />
            <span class="text-xs text-stone-500">
              Expiry is counted from this day. Set it in the past to carry over an existing plan.
            </span>
          </label>
          <fieldset class="space-y-2 rounded-lg bg-stone-50 p-3">
            <legend class="label px-1">
              Payment <span class="font-normal text-stone-400">(optional)</span>
            </legend>
            <div class="grid grid-cols-2 gap-2">
              <input name="amount" inputmode="decimal" placeholder={`Amount (${ctx.currency})`} class="input" />
              <select name="method" class="input">
                {PAYMENT_METHODS.map((pm) => (
                  <option value={pm} class="capitalize">
                    {pm}
                  </option>
                ))}
              </select>
            </div>
            <input name="paidOn" type="date" value={today} class="input" aria-label="Paid on" />
          </fieldset>
          <input name="note" placeholder="Note (optional)" class="input" />
          <button class="btn btn-primary w-full">Add plan</button>
        </form>
      )}
    </div>
  )}

  {tab === "classes" && (
    <Section
      title="Class history"
      description="Credits are used when a class starts, including no-shows. Waive a credit if the member shouldn't be charged."
    >
      {past.length === 0 && <p class="muted">No classes yet.</p>}
      <ul class="divide-y divide-stone-100">
        {past.map((h) => (
          <li class="flex flex-wrap items-center justify-between gap-2 py-2.5 text-sm">
            <a href={`/s/${ctx.slug}/admin/sessions/${h.sessionId}`} class="hover:underline">
              <span class="font-medium">
                {formatDay(h.localDate)} · {formatTime(h.startsAt, ctx.timezone)}
              </span>
              <span class="ml-2" style={`color:${h.color}`}>
                {h.icon} {h.templateName}
              </span>
              <span class="ml-2">
                <BookingStatus
                  status={h.status}
                  charged={h.charged}
                  noShow={h.noShow}
                  settled={h.settled}
                  sessionCancelled={h.sessionCancelled}
                />
              </span>
            </a>
            {!h.sessionCancelled && h.status !== "cancelled" && (
              <BookingControls
                bookingId={h.bookingId}
                status={h.status}
                charged={h.charged}
                noShow={h.noShow}
                started={h.startsAt <= now}
              />
            )}
          </li>
        ))}
      </ul>
    </Section>
  )}

  {tab === "notes" && (
    <div class="grid gap-6 lg:grid-cols-[1fr_22rem]">
      <Section title="Fitness notes">
        {notes.length === 0 && <p class="muted">No notes yet.</p>}
        <ul class="space-y-3">
          {notes.map((n) =>
            editingNote === n.id ? (
              <form method="post" class="space-y-2 rounded-lg border border-stone-300 p-3">
                <input type="hidden" name="_action" value="editNote" />
                <input type="hidden" name="noteId" value={n.id} />
                <input type="hidden" name="_redirect" value={`${Astro.url.pathname}?tab=notes`} />
                <textarea name="body" rows="4" class="input">{n.body}</textarea>
                <div class="flex items-center gap-2">
                  <select name="visibility" class="input w-auto">
                    <option value="private" selected={n.visibility === "private"}>
                      Private (coaches only)
                    </option>
                    <option value="shared" selected={n.visibility === "shared"}>
                      Shared with member
                    </option>
                  </select>
                  <button class="btn btn-primary btn-sm">Save</button>
                  <a href="?tab=notes" class="btn btn-sm">
                    Cancel
                  </a>
                </div>
              </form>
            ) : (
              <li
                class:list={[
                  "rounded-lg border p-3 text-sm",
                  n.visibility === "private" ? "border-amber-200 bg-amber-50/50" : "border-stone-200",
                ]}
              >
                <div class="mb-1 flex items-center justify-between gap-2">
                  <span
                    class:list={[
                      "badge",
                      n.visibility === "private" ? "bg-amber-100 text-amber-800" : "bg-sky-100 text-sky-800",
                    ]}
                  >
                    {n.visibility === "private" ? "🔒 Private" : "👁 Shared with member"}
                  </span>
                  <span class="flex gap-1">
                    <a href={`?tab=notes&note=${n.id}`} class="btn btn-sm">
                      Edit
                    </a>
                    <form method="post">
                      <input type="hidden" name="noteId" value={n.id} />
                      <button
                        class="btn btn-sm btn-danger"
                        name="_action"
                        value="deleteNote"
                        onclick="return confirm('Delete this note?')"
                      >
                        Delete
                      </button>
                    </form>
                  </span>
                </div>
                <p class="whitespace-pre-line">{n.body}</p>
                <p class="muted mt-1 text-xs">
                  {n.authorName} · {formatInstant(n.createdAt, ctx.timezone)}
                </p>
              </li>
            ),
          )}
        </ul>
      </Section>
      <form method="post" class="card h-fit space-y-3 p-5">
        <h2 class="h2">Add a note</h2>
        <input type="hidden" name="_action" value="note" />
        <textarea name="body" rows="5" required class="input" placeholder="Goals, injuries, progress…"></textarea>
        <fieldset class="space-y-1 text-sm">
          <label class="flex items-start gap-2">
            <input type="radio" name="visibility" value="private" checked class="mt-1" />{" "}
            <span>
              <b>Private</b> — only coaches see it
            </span>
          </label>
          <label class="flex items-start gap-2">
            <input type="radio" name="visibility" value="shared" class="mt-1" />{" "}
            <span>
              <b>Shared</b> — the member sees it on their page
            </span>
          </label>
        </fieldset>
        <button class="btn btn-primary w-full">Save note</button>
      </form>
    </div>
  )}

  {tab === "payments" && (
    <div class="grid gap-6 lg:grid-cols-[1fr_22rem]">
      <Section title="Payment history" description={`${formatMoney(totalPaid, ctx.currency)} in total`}>
        {payments.length === 0 && <p class="muted">No payments recorded.</p>}
        <table class="table">
          <tbody>
            {payments.map((p) => (
              <tr>
                <td>{formatDate(p.paidOn)}</td>
                <td>
                  {p.packName ?? "—"}
                  {p.note && <span class="muted block text-xs">{p.note}</span>}
                </td>
                <td class="capitalize">{p.method}</td>
                <td class="text-right font-medium tabular-nums">{formatMoney(p.amountCents, p.currency)}</td>
                <td class="text-right">
                  {canCredits && (
                    <form method="post">
                      <input type="hidden" name="paymentId" value={p.id} />
                      <button
                        class="btn btn-sm btn-danger"
                        name="_action"
                        value="deletePayment"
                        onclick="return confirm('Delete this payment record?')"
                      >
                        Delete
                      </button>
                    </form>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </Section>
      {canCredits && (
        <form method="post" class="card h-fit space-y-3 p-5">
          <h2 class="h2">Record a payment</h2>
          <p class="muted">
            For payments not tied to adding a plan. Plans added with a payment show up here automatically.
          </p>
          <input type="hidden" name="_action" value="payment" />
          <div class="grid grid-cols-2 gap-2">
            <input name="amount" inputmode="decimal" required placeholder={`Amount (${ctx.currency})`} class="input" />
            <select name="method" class="input">
              {PAYMENT_METHODS.map((pm) => (
                <option value={pm}>{pm}</option>
              ))}
            </select>
          </div>
          <input name="paidOn" type="date" value={today} class="input" aria-label="Paid on" />
          <select name="packId" class="input">
            <option value="">Not linked to a plan</option>
            {packs.map((p) => (
              <option value={p.id}>
                {p.name} (from {formatDate(p.startsOn)})
              </option>
            ))}
          </select>
          <input name="note" placeholder="Note (optional)" class="input" />
          <button class="btn btn-primary w-full">Record payment</button>
        </form>
      )}
    </div>
  )}

  {tab === "activity" && (
    <div class="grid gap-6 lg:grid-cols-[1fr_22rem]">
      <Section title="Changes by staff" description="Every manual change to this member's plans, credits and bookings.">
        {log.length === 0 && <p class="muted">No manual changes.</p>}
        <ul class="divide-y divide-stone-100 text-sm">
          {log.map((l) => (
            <li class="flex justify-between gap-3 py-2.5">
              <span>{auditText[l.action]?.(l.details) ?? l.action}</span>
              <span class="muted shrink-0 text-xs">
                {l.actorName ?? "—"} · {formatInstant(l.createdAt, ctx.timezone)}
              </span>
            </li>
          ))}
        </ul>
      </Section>
      <div class="space-y-6">
        <form method="post" class="card space-y-3 p-5">
          <h2 class="h2">Profile</h2>
          <input type="hidden" name="_action" value="profile" />
          <label class="block space-y-1">
            <span class="label">Name</span>
            <input name="name" required class="input" value={m.name} />
          </label>
          <label class="block space-y-1">
            <span class="label">Phone</span>
            <input name="phone" class="input" value={m.phone ?? ""} />
          </label>
          <button class="btn w-full">Save profile</button>
        </form>
        {can(ctx.role, "staff:manage") && m.userId !== ctx.userId && (
          <form method="post" class="card space-y-3 p-5">
            <h2 class="h2">Role</h2>
            <input type="hidden" name="_action" value="role" />
            <select name="role" class="input">
              <option value="member" selected={m.role === "member"}>
                Member
              </option>
              <option value="coach" selected={m.role === "coach"}>
                Coach — manages classes, members and credits
              </option>
              <option value="owner" selected={m.role === "owner"}>
                Owner — also settings and staff
              </option>
            </select>
            <button class="btn w-full">Change role</button>
          </form>
        )}
      </div>
    </div>
  )}
</Studio>
