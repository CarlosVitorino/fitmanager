---
import { plural } from "../../../../../lib/format";
import { t } from "../../../../../i18n";
import Avatar from "../../../../../components/Avatar.astro";
import Studio from "../../../../../layouts/Studio.astro";
import { daysBetween, localDateOf } from "../../../../../domain/dates";
import { formatDate } from "../../../../../lib/format";
import { can } from "../../../../../server/authz";
import { getSettings, listMembers } from "../../../../../server/members";

const ctx = Astro.locals.studio!;
const all = await listMembers(ctx);
const today = localDateOf(new Date(), ctx.timezone);
const q = (Astro.url.searchParams.get("q") ?? "").trim().toLowerCase();
const filter = Astro.url.searchParams.get("filter") ?? "all";
const filters = {
  all: { label: t("members.list.everyone"), test: () => true },
  expiring: {
    label: t("members.list.expiring"),
    test: (m: (typeof all)[number]) =>
      m.nextExpiry !== null && daysBetween(today, m.nextExpiry) <= 14 && m.available > 0,
  },
  low: { label: t("members.list.low"), test: (m: (typeof all)[number]) => m.activePacks > 0 && m.available <= 2 },
  none: {
    label: t("members.list.noPlanFilter"),
    test: (m: (typeof all)[number]) => m.activePacks === 0 && m.role === "member",
  },
  staff: { label: t("members.list.staff"), test: (m: (typeof all)[number]) => m.role !== "member" },
} as const;
const f = filters[filter as keyof typeof filters] ?? filters.all;
const rows = all
  .filter((m) => (filter === "staff" ? true : filter === "all" ? true : m.role === "member"))
  .filter((m) => f.test(m))
  .filter((m) => !q || m.name.toLowerCase().includes(q) || m.email.toLowerCase().includes(q));
const invite = can(ctx.role, "staff:manage")
  ? new URL(`/join/${ctx.slug}/${(await getSettings(ctx)).joinCode}`, Astro.url).toString()
  : null;
const base = `/s/${ctx.slug}/admin/members`;
---

<Studio title={t("members.list.title")} wide>
  <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight">{t("members.list.title")}</h1>
      <p class="muted">
        {t("members.list.summary", {
          members: plural(all.filter((m) => m.role === "member").length, "members"),
          staff: all.filter((m) => m.role !== "member").length,
        })}
      </p>
    </div>
    {invite && (
      <div class="flex items-center gap-2">
        <span class="muted hidden sm:inline">{t("members.list.inviteLink")}</span>
        <input readonly class="input w-72 font-mono text-xs" value={invite} id="invite" onclick="this.select()" />
        <button
          type="button"
          class="btn"
          data-copied={t("common.copied")}
          onclick="navigator.clipboard.writeText(document.getElementById('invite').value);this.textContent=this.dataset.copied"
        >
          {t("common.copy")}
        </button>
      </div>
    )}
  </div>

  <div class="mb-4 flex flex-wrap items-center gap-2">
    {Object.entries(filters).map(([key, v]) => (
      <a href={`?filter=${key}`} class:list={["btn btn-sm", filter === key && "btn-primary"]}>
        {v.label}
      </a>
    ))}
    <form class="ml-auto">
      <input type="hidden" name="filter" value={filter} />
      <input name="q" value={q} placeholder={t("members.list.search")} class="input w-60" />
    </form>
  </div>

  <div class="card overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <th>{t("members.list.name")}</th>
          <th>{t("members.list.contact")}</th>
          <th class="text-right">{t("members.list.credits")}</th>
          <th>{t("members.list.nextExpiry")}</th>
          <th>{t("members.list.lastClass")}</th>
          <th class="text-right">{t("members.list.upcoming")}</th>
        </tr>
      </thead>
      <tbody>
        {rows.length === 0 && (
          <tr>
            <td colspan="6" class="py-8 text-center text-stone-500">
              {t("members.list.noMatch")}
            </td>
          </tr>
        )}
        {rows.map((m) => {
          const days = m.nextExpiry ? daysBetween(today, m.nextExpiry) : null;
          return (
            <tr class="hover:bg-stone-50">
              <td>
                <a href={`${base}/${m.userId}`} class="flex items-center gap-3 font-medium hover:underline">
                  <Avatar name={m.name} size="sm" />
                  {m.name}
                  {m.role !== "member" && (
                    <span class="badge bg-stone-900 text-white">
                      {m.role === "owner" ? t("auth.roleOwner") : t("auth.roleCoach")}
                    </span>
                  )}
                </a>
              </td>
              <td class="text-stone-600">
                {m.email}
                {m.phone && <span class="block text-xs text-stone-500">{m.phone}</span>}
              </td>
              <td class="text-right">
                {m.role === "member" &&
                  (m.activePacks === 0 ? (
                    <span class="badge bg-stone-100 text-stone-600">{t("members.list.noPlan")}</span>
                  ) : (
                    <span
                      class:list={[
                        "badge tabular-nums",
                        m.available <= 2 ? "bg-red-50 text-red-700" : "bg-emerald-50 text-emerald-800",
                      ]}
                    >
                      {m.available}
                    </span>
                  ))}
              </td>
              <td>
                {m.nextExpiry ? (
                  <span class:list={[days !== null && days <= 14 && "font-medium text-amber-700"]}>
                    {formatDate(m.nextExpiry)}
                  </span>
                ) : (
                  <span class="text-stone-400">—</span>
                )}
              </td>
              <td class="text-stone-600">
                {m.lastClass ? (
                  formatDate(localDateOf(m.lastClass, ctx.timezone))
                ) : (
                  <span class="text-stone-400">—</span>
                )}
              </td>
              <td class="text-right tabular-nums">{m.upcoming || <span class="text-stone-400">0</span>}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</Studio>
