---
import { BatteryLow, CalendarDays, Hourglass, UserPlus, UserX } from "@lucide/astro";
import { t } from "../../../i18n";
import Avatar from "../../../components/Avatar.astro";
import PageHeader from "../../../components/PageHeader.astro";
import Section from "../../../components/Section.astro";
import StatTile from "../../../components/StatTile.astro";
import Studio from "../../../layouts/Studio.astro";
import { addDays, daysBetween, localDateOf } from "../../../domain/dates";
import { formatDate, formatDayLong, formatTimeRange, plural } from "../../../lib/format";
import { isStaff } from "../../../server/authz";
import { listMembers, packsExpiringSoon } from "../../../server/members";
import { listSessions } from "../../../server/schedule";

const ctx = Astro.locals.studio!;
if (!isStaff(ctx.role)) return Astro.redirect(`/s/${ctx.slug}/me`);

const today = localDateOf(new Date(), ctx.timezone);
const [todays, tomorrow, expiring, members] = await Promise.all([
  listSessions(ctx, today, today),
  listSessions(ctx, addDays(today, 1), addDays(today, 1)),
  packsExpiringSoon(ctx, 14),
  listMembers(ctx),
]);
const memberRows = members.filter((m) => m.role === "member");
const lowCredits = memberRows.filter((m) => m.activePacks > 0 && m.available <= 2);
const noPlan = memberRows.filter((m) => m.activePacks === 0);
const expiringWithCredits = expiring.filter((p) => p.available > 0);
const base = `/s/${ctx.slug}/admin`;
const now = new Date();
---

<Studio title={t("nav.today")}>
  <PageHeader
    title={formatDayLong(today)}
    subtitle={t("booking.today.subtitle", {
      classes: plural(todays.length, "classes"),
      members: plural(memberRows.length, "members"),
    })}
  >
    <a href={`${base}/calendar`} class="btn">
      <CalendarDays size={16} /> {t("booking.today.calendar")}
    </a>
    <a href={`${base}/members`} class="btn btn-primary">
      <UserPlus size={16} /> {t("booking.today.addPlan")}
    </a>
  </PageHeader>

  <div class="mb-6 grid gap-3 sm:grid-cols-3">
    <StatTile
      href={`${base}/members?filter=expiring`}
      value={expiringWithCredits.length}
      label={t("booking.today.expiringTile")}
      hint={t("booking.today.expiringHint")}
      tone="amber"
    >
      <Hourglass slot="icon" size={20} />
    </StatTile>
    <StatTile
      href={`${base}/members?filter=low`}
      value={lowCredits.length}
      label={t("booking.today.lowTile")}
      hint={t("booking.today.lowHint")}
      tone="rose"
    >
      <BatteryLow slot="icon" size={20} />
    </StatTile>
    <StatTile
      href={`${base}/members?filter=none`}
      value={noPlan.length}
      label={t("booking.today.noPlanTile")}
      hint={t("booking.today.noPlanHint")}
      tone="stone"
    >
      <UserX slot="icon" size={20} />
    </StatTile>
  </div>

  <div class="grid gap-6 lg:grid-cols-[1fr_22rem]">
    <div class="space-y-6">
      <Section title={t("booking.today.todaysClasses")}>
        <CalendarDays slot="icon" size={18} />
        {todays.length === 0 && <p class="muted">{t("booking.today.noClassesToday")}</p>}
        <ul class="space-y-2">
          {todays.map((s) => (
            <li>
              <a
                href={`${base}/sessions/${s.id}`}
                class:list={[
                  "flex items-center justify-between rounded-lg border-l-4 p-3 hover:brightness-95",
                  s.endsAt < now && "opacity-60",
                ]}
                style={`border-left-color:${s.color};background:${s.color}10`}
              >
                <span>
                  <span class="font-semibold">{formatTimeRange(s.startsAt, s.endsAt, ctx.timezone)}</span>
                  <span class="ml-2 font-medium" style={`color:${s.color}`}>
                    {s.icon} {s.templateName}
                  </span>
                  <span class="muted block">
                    {s.calendarName}
                    {s.coachName && ` · ${s.coachName}`}
                  </span>
                </span>
                <span class="text-right">
                  <span class="text-lg font-semibold tabular-nums">
                    {s.booked}/{s.capacity}
                  </span>
                  <span class="muted block text-xs">
                    {s.endsAt < now
                      ? t("booking.today.done")
                      : s.startsAt < now
                        ? t("booking.today.inProgress")
                        : t("booking.today.bookedLabel")}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        {tomorrow.length > 0 && (
          <p class="muted mt-4">
            {t("booking.today.tomorrow", {
              list: tomorrow
                .map(
                  (s) =>
                    `${formatTimeRange(s.startsAt, s.endsAt, ctx.timezone).split("–")[0]} ${s.templateName} (${s.booked}/${s.capacity})`,
                )
                .join(" · "),
            })}
          </p>
        )}
      </Section>
    </div>

    <div class="space-y-6">
      <Section title={t("booking.today.expiringSoon")} description={t("booking.today.expiringSoonHint")}>
        <Hourglass slot="icon" size={18} />
        {expiring.length === 0 && <p class="muted">{t("booking.today.nothingExpiring")}</p>}
        <ul class="space-y-2">
          {expiring.map((p) => {
            const days = daysBetween(today, p.expiresOn!);
            return (
              <li class="flex items-center justify-between gap-2 text-sm">
                <a href={`${base}/members/${p.memberId}`} class="flex items-center gap-2.5 hover:underline">
                  <Avatar name={p.memberName} size="sm" />
                  <span>
                    <span class="block font-medium">{p.memberName}</span>
                    <span class="muted block text-xs">
                      {p.name} ·{" "}
                      {days === 0
                        ? t("booking.today.lastDay")
                        : t("booking.today.ends", { date: formatDate(p.expiresOn!) })}
                    </span>
                  </span>
                </a>
                <span
                  class:list={[
                    "badge",
                    p.available > 0 ? "bg-amber-100 text-amber-800" : "bg-stone-100 text-stone-600",
                  ]}
                >
                  {t("booking.today.creditsLeft", { count: p.available })}
                </span>
              </li>
            );
          })}
        </ul>
      </Section>
      <Section title={t("booking.today.runningLow")}>
        <BatteryLow slot="icon" size={18} />
        {lowCredits.length === 0 && <p class="muted">{t("booking.today.everyoneHasCredits")}</p>}
        <ul class="space-y-2">
          {lowCredits.map((m) => (
            <li class="flex items-center justify-between text-sm">
              <a href={`${base}/members/${m.userId}`} class="flex items-center gap-2.5 font-medium hover:underline">
                <Avatar name={m.name} size="sm" />
                {m.name}
              </a>
              <span class="badge bg-red-50 text-red-700">{plural(m.available, "credits")}</span>
            </li>
          ))}
        </ul>
      </Section>
    </div>
  </div>
</Studio>
