---
import Base from "../../../layouts/Base.astro";
import { isStaff } from "../../../server/authz";

const studio = Astro.locals.studio!;
const staff = isStaff(studio.role);
---

<Base title={studio.name}>
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-semibold">{studio.name}</h1>
      <p class="text-sm capitalize text-stone-500">
        You are {studio.role === "owner" ? "the owner" : `a ${studio.role}`} · {studio.timezone}
      </p>
    </div>
    {staff ? (
      <section class="grid gap-3 sm:grid-cols-2">
        {["Members", "Calendars", "Class templates", "Plans", "Settings"].map((label) => (
          <div class="rounded border border-dashed border-stone-300 bg-white px-4 py-6 text-stone-500">
            {label} — coming in Phase 3
          </div>
        ))}
      </section>
    ) : (
      <section class="grid gap-3 sm:grid-cols-2">
        {["Book a class", "My plans", "Progress"].map((label) => (
          <div class="rounded border border-dashed border-stone-300 bg-white px-4 py-6 text-stone-500">
            {label} — coming in Phase 3
          </div>
        ))}
      </section>
    )}
  </div>
</Base>
