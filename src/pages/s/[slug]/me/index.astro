---
import { t } from "../../../../i18n";
import { goalLabel, paymentMethodLabel, validityLabel } from "../../../../server/labels";
import {
  Award,
  CalendarCheck,
  CalendarDays,
  CalendarPlus,
  Clock,
  Flame,
  MessageSquareText,
  Sparkles,
  Target,
  Trophy,
} from "@lucide/astro";
import BookingStatus from "../../../../components/BookingStatus.astro";
import EmptyState from "../../../../components/EmptyState.astro";
import PageHeader from "../../../../components/PageHeader.astro";
import Section from "../../../../components/Section.astro";
import StatTile from "../../../../components/StatTile.astro";
import AttendanceChart from "../../../../components/profile/AttendanceChart.astro";
import CurrentPlan from "../../../../components/profile/CurrentPlan.astro";
import NoteCard from "../../../../components/profile/NoteCard.astro";
import Studio from "../../../../layouts/Studio.astro";
import { localDateOf } from "../../../../domain/dates";
import { weeklyCounts } from "../../../../domain/progress";
import { formatDate, formatDay, formatDayLong, formatMoney, formatTime, plural } from "../../../../lib/format";
import { handleActions, str } from "../../../../server/actions";
import { cancelOwnBooking } from "../../../../server/bookings";
import { listPackTypes } from "../../../../server/catalog";
import {
  attendedDates,
  classHistory,
  getMember,
  listNotes,
  listPayments,
  memberAchievements,
} from "../../../../server/members";
import { memberPacks, validityOf } from "../../../../server/packs";
import { getFitness } from "../../../../server/profiles";
import { isStaff } from "../../../../server/authz";

const ctx = Astro.locals.studio!;
const base = `/s/${ctx.slug}`;

const result = await handleActions(Astro, {
  cancel: async (f) => {
    const outcome = await cancelOwnBooking(ctx, str(f, "bookingId"));
    return outcome === "released" ? t("booking.flash.cancelledReleased") : t("booking.flash.cancelledLate");
  },
});
if (result instanceof Response) return result;

const [me, packs, history, notes, payments, plans, fitness] = await Promise.all([
  getMember(ctx, ctx.userId),
  memberPacks(ctx, ctx.userId),
  classHistory(ctx, ctx.userId),
  listNotes(ctx, ctx.userId),
  listPayments(ctx, { memberId: ctx.userId }),
  listPackTypes(ctx),
  getFitness(ctx, ctx.userId),
]);
const today = localDateOf(new Date(), ctx.timezone);
const a = memberAchievements(ctx, history);
const attended = attendedDates(history);
const weeks = weeklyCounts(attended, today, 12);
const thisMonth = attended.filter((d) => d.slice(0, 7) === today.slice(0, 7)).length;
const now = new Date();
const upcoming = history.filter((h) => h.status === "booked" && h.startsAt > now && !h.sessionCancelled).reverse();
const next = upcoming[0];
const recent = history.filter((h) => !(h.status === "booked" && h.startsAt > now && !h.sessionCancelled)).slice(0, 8);
const reached = a.milestones.filter((m) => m.reachedOn);
const minsToNext = next ? Math.floor((next.startsAt.getTime() - now.getTime()) / 60_000) : 0;
const lateCancel = minsToNext < ctx.cancellationCutoffMinutes;
const firstName = me.name.split(" ")[0];
---

<Studio title={t("nav.home")} flash={result.flash} error={result.error}>
  <PageHeader title={t("profile.me.hi", { name: firstName })} subtitle={t("profile.me.subtitle", { studio: ctx.name })}>
    {isStaff(ctx.role) && (
      <a href={base} class="btn">
        {t("common.backToStudio")}
      </a>
    )}
    <a href={`${base}/book`} class="btn btn-primary">
      <CalendarPlus size={16} /> {t("nav.book")}
    </a>
  </PageHeader>

  <div class="mb-6 grid grid-cols-2 gap-3 lg:grid-cols-4">
    <StatTile label={t("profile.me.classesDone")} value={a.totalClasses} tone="stone">
      <CalendarCheck slot="icon" size={20} />
    </StatTile>
    <StatTile
      label={t("profile.me.weekStreak")}
      value={a.currentStreakWeeks}
      hint={
        a.longestStreakWeeks > a.currentStreakWeeks ? t("profile.me.best", { count: a.longestStreakWeeks }) : undefined
      }
      tone="amber"
    >
      <Flame slot="icon" size={20} />
    </StatTile>
    <StatTile label={t("profile.me.thisMonth")} value={thisMonth} tone="sky">
      <CalendarDays slot="icon" size={20} />
    </StatTile>
    <StatTile
      label={
        a.nextMilestone ? t("profile.me.toReach", { count: a.nextMilestone.count }) : t("profile.me.milestonesReached")
      }
      value={a.nextMilestone ? a.nextMilestone.remaining : reached.length}
      tone="violet"
    >
      <Trophy slot="icon" size={20} />
    </StatTile>
  </div>

  <div class="grid gap-6 lg:grid-cols-[1fr_20rem]">
    <div class="space-y-6">
      <Section title={t("profile.me.nextClass")}>
        <CalendarDays slot="icon" size={18} />
        {next ? (
          <div>
            <div class="flex flex-wrap items-center gap-4 rounded-xl p-4" style={`background:${next.color}14`}>
              <div
                class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl text-3xl"
                style={`background:${next.color}26`}
                aria-hidden="true"
              >
                {next.icon}
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-lg font-semibold" style={`color:${next.color}`}>
                  {next.templateName}
                </p>
                <p class="text-sm text-stone-700">
                  {formatDayLong(next.localDate)} · {formatTime(next.startsAt, ctx.timezone)}
                </p>
                <p class="text-xs text-stone-500">{next.calendarName}</p>
              </div>
              <form method="post" class="text-right">
                <input type="hidden" name="_action" value="cancel" />
                <input type="hidden" name="bookingId" value={next.bookingId} />
                <button
                  class="btn btn-sm"
                  onclick={lateCancel ? `return confirm(${JSON.stringify(t("profile.me.lateConfirm"))})` : undefined}
                >
                  {t("common.cancel")}
                </button>
                {lateCancel && <p class="mt-1 text-[11px] text-amber-700">{t("profile.me.noRefund")}</p>}
              </form>
            </div>
            {upcoming.length > 1 && (
              <ul class="mt-3 divide-y divide-stone-100">
                {upcoming.slice(1).map((h) => (
                  <li class="flex items-center gap-3 py-2.5 text-sm">
                    <span class="w-28 shrink-0 font-medium">{formatDay(h.localDate)}</span>
                    <span class="w-12 shrink-0 text-stone-500 tabular-nums">
                      {formatTime(h.startsAt, ctx.timezone)}
                    </span>
                    <span class="truncate" style={`color:${h.color}`}>
                      {h.icon} {h.templateName}
                    </span>
                    <form method="post" class="ml-auto">
                      <input type="hidden" name="_action" value="cancel" />
                      <input type="hidden" name="bookingId" value={h.bookingId} />
                      <button class="text-xs text-stone-500 underline hover:text-stone-900">
                        {t("common.cancel")}
                      </button>
                    </form>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ) : (
          <EmptyState title={t("profile.me.nothingBooked")} text={t("profile.me.nothingBookedHint")}>
            <CalendarDays slot="icon" size={20} />
            <a href={`${base}/book`} class="btn btn-primary btn-sm">
              {t("nav.book")}
            </a>
          </EmptyState>
        )}
      </Section>

      <Section title={t("profile.me.progress")} description={t("profile.me.progressHint")}>
        <Sparkles slot="icon" size={18} />
        <AttendanceChart weeks={weeks} />
        <div class="mt-5 flex flex-wrap gap-2 border-t border-stone-100 pt-4">
          {a.milestones.slice(0, 6).map((m) => (
            <span
              class:list={[
                "inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium",
                m.reachedOn ? "bg-amber-100 text-amber-900" : "bg-stone-100 text-stone-400",
              ]}
              title={
                m.reachedOn ? t("profile.me.reachedOn", { date: formatDate(m.reachedOn) }) : t("profile.me.notReached")
              }
            >
              <Award size={13} />
              {m.count === 1 ? t("profile.me.firstClass") : t("profile.me.nClasses", { count: m.count })}
            </span>
          ))}
        </div>
      </Section>

      <Section title={t("profile.me.fromCoach")}>
        <MessageSquareText slot="icon" size={18} />
        {notes.length ? (
          <div class="space-y-3">
            {notes.slice(0, 3).map((n) => (
              <NoteCard note={n} timezone={ctx.timezone} />
            ))}
            {notes.length > 3 && (
              <details>
                <summary class="muted cursor-pointer">
                  {t("profile.me.olderNotes", { count: notes.length - 3 })}
                </summary>
                <div class="mt-3 space-y-3">
                  {notes.slice(3).map((n) => (
                    <NoteCard note={n} timezone={ctx.timezone} />
                  ))}
                </div>
              </details>
            )}
          </div>
        ) : (
          <EmptyState title={t("profile.me.noNotes")} text={t("profile.me.noNotesHint")} compact>
            <MessageSquareText slot="icon" size={20} />
          </EmptyState>
        )}
      </Section>

      <Section title={t("profile.me.recent")}>
        <Clock slot="icon" size={18} />
        {recent.length ? (
          <ul class="divide-y divide-stone-100">
            {recent.map((h) => (
              <li class="flex flex-wrap items-center gap-x-3 gap-y-1 py-2.5 text-sm">
                <span class="w-28 shrink-0 font-medium">{formatDay(h.localDate)}</span>
                <span class="w-12 shrink-0 text-stone-500 tabular-nums">{formatTime(h.startsAt, ctx.timezone)}</span>
                <span style={`color:${h.color}`}>
                  {h.icon} {h.templateName}
                </span>
                <span class="ml-auto">
                  <BookingStatus
                    status={h.status}
                    charged={h.charged}
                    noShow={h.noShow}
                    settled={h.settled}
                    sessionCancelled={h.sessionCancelled}
                  />
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <EmptyState title={t("profile.me.noClasses")} compact>
            <Clock slot="icon" size={20} />
          </EmptyState>
        )}
      </Section>
    </div>

    <aside class="space-y-6">
      <div class="card p-5">
        <CurrentPlan packs={packs} timezone={ctx.timezone}>
          <p slot="empty" class="mt-1 text-sm text-stone-500">
            {t("profile.me.askForPlan")}
          </p>
        </CurrentPlan>
      </div>

      {(fitness.goals.length > 0 || fitness.shared.goals) && (
        <a href={`${base}/me/profile`} class="card block p-5 transition hover:border-stone-300">
          <p class="eyebrow flex items-center gap-1.5">
            <Target size={13} /> {t("profile.me.yourGoals")}
          </p>
          {fitness.goals.length ? (
            <div class="mt-2 flex flex-wrap gap-1.5">
              {fitness.goals.map((g) => (
                <span class="chip">{goalLabel(g)}</span>
              ))}
            </div>
          ) : (
            <p class="mt-2 text-sm text-stone-500">{t("profile.me.noGoals")}</p>
          )}
          <p class="mt-3 text-xs font-medium text-stone-600">{t("profile.me.seeProfile")}</p>
        </a>
      )}

      <Section title={t("profile.me.plansOffered")} description={t("profile.me.plansOfferedHint")}>
        <ul class="space-y-3">
          {plans.map((p) => (
            <li class="text-sm">
              <div class="flex justify-between gap-2 font-medium">
                <span>{p.name}</span>
                <span class="tabular-nums">{formatMoney(p.priceCents, ctx.currency)}</span>
              </div>
              <div class="text-xs text-stone-500">
                {plural(p.entries, "classes")} · {validityLabel(validityOf(p))}
              </div>
            </li>
          ))}
        </ul>
      </Section>

      {(payments.length > 0 || packs.some((p) => p.status === "expired" || p.status === "used_up")) && (
        <details class="card p-5">
          <summary class="cursor-pointer text-sm font-semibold">{t("profile.me.history")}</summary>
          <ul class="mt-3 space-y-2 text-sm">
            {packs
              .filter((p) => p.status === "expired" || p.status === "used_up")
              .map((p) => (
                <li class="flex justify-between gap-2">
                  <span class="text-stone-600">{p.name}</span>
                  <span class="text-xs text-stone-500">
                    {p.status === "expired"
                      ? t("profile.me.expiredOn", { date: formatDate(p.expiresOn!) })
                      : t("profile.me.usedUp")}
                  </span>
                </li>
              ))}
            {payments.map((p) => (
              <li class="flex justify-between gap-2">
                <span class="text-stone-600">
                  {formatDate(p.paidOn)} <span class="text-xs text-stone-400">· {paymentMethodLabel(p.method)}</span>
                </span>
                <span class="font-medium tabular-nums">{formatMoney(p.amountCents, p.currency)}</span>
              </li>
            ))}
          </ul>
        </details>
      )}
    </aside>
  </div>
</Studio>
