---
import { HeartPulse, UserRound } from "@lucide/astro";
import Avatar from "../../../../components/Avatar.astro";
import PageHeader from "../../../../components/PageHeader.astro";
import Section from "../../../../components/Section.astro";
import FitnessView from "../../../../components/profile/FitnessView.astro";
import PersonalForm from "../../../../components/profile/PersonalForm.astro";
import Studio from "../../../../layouts/Studio.astro";
import { ageOn } from "../../../../domain/progress";
import { localDateOf } from "../../../../domain/dates";
import { formatDate } from "../../../../lib/format";
import { handleActions } from "../../../../server/actions";
import { personalAction } from "../../../../server/profile-actions";
import { getFitness, getPersonal, listBenchmarks, listMeasurements } from "../../../../server/profiles";

const ctx = Astro.locals.studio!;
const result = await handleActions(Astro, { personal: personalAction(ctx, ctx.userId) });
if (result instanceof Response) return result;

const today = localDateOf(new Date(), ctx.timezone);
const [personal, fitness, measurements, benchmarks] = await Promise.all([
  getPersonal(ctx, ctx.userId),
  getFitness(ctx, ctx.userId),
  listMeasurements(ctx, ctx.userId),
  listBenchmarks(ctx, ctx.userId),
]);
const anyShared = Object.values(fitness.shared).some(Boolean);
---

<Studio title="My profile" flash={result.flash} error={result.error}>
  <PageHeader title="My profile">
    <div slot="meta" class="mt-3 flex items-center gap-3">
      <Avatar name={personal.name} size="lg" />
      <div>
        <p class="font-medium">{personal.name}</p>
        <p class="text-sm text-stone-500">
          {personal.email}
          {personal.dateOfBirth && ` · ${ageOn(personal.dateOfBirth, today)} years`}
        </p>
      </div>
    </div>
  </PageHeader>

  <div class="space-y-8">
    <div>
      <div class="mb-3 flex items-center gap-2">
        <HeartPulse size={18} class="text-stone-400" />
        <h2 class="text-lg font-semibold tracking-tight">Fitness profile</h2>
        {fitness.updatedAt && (
          <span class="text-xs text-stone-400">
            · updated by your coach {formatDate(localDateOf(fitness.updatedAt, ctx.timezone))}
          </span>
        )}
      </div>
      {anyShared ? (
        <FitnessView profile={fitness} measurements={measurements} benchmarks={benchmarks} memberView />
      ) : (
        <p class="card p-5 text-sm text-stone-500">Your coach hasn't shared your fitness profile yet.</p>
      )}
    </div>

    <Section title="Personal details" description="Only you and the studio's coaches can see these.">
      <UserRound slot="icon" size={18} />
      <PersonalForm p={personal} today={today} />
    </Section>
  </div>
</Studio>
