---
import Studio from "../../../layouts/Studio.astro";
import ClassCalendar from "../../../components/islands/ClassCalendar";
import { addDays, isLocalDate, localDateOf } from "../../../domain/dates";
import { formatDate, formatDayLong, formatMinutes, formatTime } from "../../../lib/format";
import { handleActions, str } from "../../../server/actions";
import { bookSelf, cancelOwnBooking } from "../../../server/bookings";
import { listCalendars } from "../../../server/catalog";
import { memberPacks } from "../../../server/packs";
import { listSessions, SCHEDULE_HORIZON_DAYS, toCalendarSessions } from "../../../server/schedule";

const ctx = Astro.locals.studio!;
const today = localDateOf(new Date(), ctx.timezone);
const calendarId = Astro.url.searchParams.get("calendar") || undefined;
const dateParam = Astro.url.searchParams.get("date");
const selectedDate = dateParam && isLocalDate(dateParam) && dateParam >= today ? dateParam : today;

const result = await handleActions(Astro, {
  book: async (f) => {
    const { session } = await bookSelf(ctx, str(f, "sessionId"));
    return `You're booked for ${formatDayLong(session.localDate)} at ${formatTime(session.startsAt, ctx.timezone)}.`;
  },
  cancel: async (f) => {
    const outcome = await cancelOwnBooking(ctx, str(f, "bookingId"));
    return outcome === "released"
      ? "Booking cancelled. Your credit is back."
      : "Booking cancelled. It was inside the cancellation window, so the credit is used.";
  },
});
if (result instanceof Response) return result;

const [sessions, calendars, packs] = await Promise.all([
  listSessions(ctx, today, addDays(today, SCHEDULE_HORIZON_DAYS), { calendarId, forMemberId: ctx.userId }),
  listCalendars(ctx),
  memberPacks(ctx, ctx.userId),
]);
const filterLink = (cal?: string) =>
  `?${new URLSearchParams({ ...(cal ? { calendar: cal } : {}), date: selectedDate })}`;
const credits = packs.filter((p) => p.status === "active").reduce((n, p) => n + p.available, 0);
const nextExpiry = packs
  .filter((p) => p.status === "active" && p.available > 0 && p.expiresOn)
  .map((p) => p.expiresOn!)[0];
---

<Studio title="Book a class" flash={result.flash} error={result.error} wide>
  <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-semibold">Book a class</h1>
      <p class="muted">
        Tap a class to book it. Book until {formatMinutes(ctx.bookingCutoffMinutes)} before; cancel up to{" "}
        {formatMinutes(ctx.cancellationCutoffMinutes)} before to get your credit back.
      </p>
    </div>
    <a href={`/s/${ctx.slug}/me`} class="card flex items-center gap-3 px-4 py-2.5 hover:border-stone-400">
      <span class="text-2xl font-semibold tabular-nums">{credits}</span>
      <span class="text-sm leading-tight text-stone-600">
        {credits === 1 ? "credit" : "credits"} available
        {nextExpiry && <span class="block text-xs text-stone-500">next expiry {formatDate(nextExpiry)}</span>}
      </span>
    </a>
  </div>

  {calendars.length > 1 && (
    <div class="mb-4 flex flex-wrap gap-1">
      <a href={filterLink()} class:list={["btn btn-sm", !calendarId && "btn-primary"]}>
        All
      </a>
      {calendars.map((c) => (
        <a href={filterLink(c.id)} class:list={["btn btn-sm", calendarId === c.id && "btn-primary"]}>
          {c.name}
        </a>
      ))}
    </div>
  )}

  {credits === 0 && (
    <p class="mb-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
      You have no credits right now. Ask your coach for a plan; see{" "}
      <a class="underline" href={`/s/${ctx.slug}/me#plans`}>
        the plans this studio offers
      </a>
      .
    </p>
  )}

  <ClassCalendar
    client:only="react"
    mode="member"
    sessions={toCalendarSessions(sessions)}
    timezone={ctx.timezone}
    today={today}
    selectedDate={selectedDate}
    minDate={today}
    bookingCutoffMinutes={ctx.bookingCutoffMinutes}
    cancellationCutoffMinutes={ctx.cancellationCutoffMinutes}
    credits={credits}
  />
  <noscript>
    <p class="muted mt-4">The calendar needs JavaScript.</p>
  </noscript>
</Studio>
