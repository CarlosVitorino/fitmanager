---
import Base from "../../../layouts/Base.astro";
import { HttpError } from "../../../server/errors";
import { t } from "../../../i18n";
import { findStudioByInvite, joinStudio } from "../../../server/members";

const { slug, code } = Astro.params as { slug: string; code: string };
const studio = await findStudioByInvite(slug, code);
const user = Astro.locals.user;
let error: string | null = null;

if (Astro.request.method === "POST" && user && studio) {
  try {
    await joinStudio(user.id, slug, code);
    return Astro.redirect(`/s/${slug}/me`, 303);
  } catch (e) {
    if (!(e instanceof HttpError)) throw e;
    error = e.message;
  }
}
if (!studio) Astro.response.status = 404;
const here = encodeURIComponent(Astro.url.pathname);
---

<Base title={studio ? t("auth.joinTitle", { studio: studio.name }) : t("auth.inviteInvalidTitle")} narrow>
  <div class="card space-y-5 p-7 text-center">
    {studio ? (
      <>
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-stone-900 text-2xl font-bold text-white">
          {studio.name.slice(0, 1)}
        </div>
        <h1 class="text-2xl font-semibold">{t("auth.joinTitle", { studio: studio.name })}</h1>
        <p class="text-stone-600">{t("auth.joinText")}</p>
        {error && <p class="text-sm text-red-700">{error}</p>}
        {user ? (
          <form method="post">
            <button class="w-full rounded bg-stone-900 px-4 py-2.5 font-medium text-white hover:bg-stone-700">
              {t("auth.joinAs", { name: user.name })}
            </button>
          </form>
        ) : (
          <div class="space-y-2">
            <a
              href={`/signup?next=${here}`}
              class="block rounded bg-stone-900 px-4 py-2.5 font-medium text-white hover:bg-stone-700"
            >
              {t("auth.createAccount")}
            </a>
            <a
              href={`/login?next=${here}`}
              class="block rounded border border-stone-300 bg-white px-4 py-2.5 hover:bg-stone-100"
            >
              {t("auth.haveOne")}
            </a>
          </div>
        )}
      </>
    ) : (
      <>
        <h1 class="text-2xl font-semibold">{t("auth.inviteInvalidTitle")}</h1>
        <p class="text-stone-600">{t("auth.inviteInvalidText")}</p>
      </>
    )}
  </div>
</Base>
