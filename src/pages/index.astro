---
import {
  ArrowRight,
  CalendarCheck,
  CalendarX2,
  ChevronDown,
  ChevronRight,
  Dumbbell,
  Globe,
  HeartPulse,
  Languages,
  Link2,
  MonitorPlay,
  MessageCircleQuestion,
  Sheet,
  Smartphone,
  Ticket,
  TriangleAlert,
  UserRound,
  X,
} from "@lucide/astro";
import { Image } from "astro:assets";
import Flash from "../components/Flash.astro";
import Logo from "../components/brand/Logo.astro";
import BrowserFrame from "../components/landing/BrowserFrame.astro";
import Feature from "../components/landing/Feature.astro";
import PhoneFrame from "../components/landing/PhoneFrame.astro";
import { shot } from "../components/landing/shots";
import Base from "../layouts/Base.astro";
import Landing from "../layouts/Landing.astro";
import { db } from "../db/client";
import { t } from "../i18n";
import { listUserStudios } from "../server/studio-context";

const { user } = Astro.locals;
const studios = user ? await listUserStudios(db, user.id) : [];
if (user && studios.length === 1) return Astro.redirect(`/s/${studios[0]!.slug}`);
const roleLabel = (r: string) =>
  r === "owner" ? t("auth.roleOwner") : r === "coach" ? t("auth.roleCoach") : t("auth.roleMember");

const demoState = Astro.url.searchParams.get("demo");
const notice = demoState === "ended" ? t("site.demo.ended") : null;
const problem = demoState === "busy" ? t("site.demo.busy") : demoState === "failed" ? t("site.demo.failed") : null;

const pains = [
  { icon: MessageCircleQuestion, title: t("site.home.pains.oneTitle"), text: t("site.home.pains.oneText") },
  { icon: CalendarX2, title: t("site.home.pains.twoTitle"), text: t("site.home.pains.twoText") },
  { icon: Sheet, title: t("site.home.pains.threeTitle"), text: t("site.home.pains.threeText") },
];
const facts = [
  { icon: Smartphone, text: t("site.home.proof.noApp") },
  { icon: Languages, text: t("site.home.proof.languages") },
  { icon: Link2, text: t("site.home.proof.link") },
];
const demoViews = [
  {
    role: "coach",
    icon: Dumbbell,
    title: t("site.home.pickCoachTitle"),
    text: t("site.home.pickCoachText"),
    shot: shot("today"),
  },
  {
    role: "member",
    icon: UserRound,
    title: t("site.home.pickMemberTitle"),
    text: t("site.home.pickMemberText"),
    shot: shot("phone-home"),
  },
] as const;
const steps = [
  [t("site.home.steps.oneTitle"), t("site.home.steps.oneText")],
  [t("site.home.steps.twoTitle"), t("site.home.steps.twoText")],
  [t("site.home.steps.threeTitle"), t("site.home.steps.threeText")],
];
const faq = (["app", "move", "noShow", "expiry", "studios", "language"] as const).map((k) => [
  t(`site.home.faq.${k}Q`),
  t(`site.home.faq.${k}A`),
]);
const classTypes = t("site.home.classTypes").split(" · ");
---

{user ? (
  <Base title={t("common.home")}>
    <div class="mx-auto max-w-lg space-y-6">
      <h1 class="text-2xl font-semibold tracking-tight">{t("auth.yourStudios")}</h1>
      {studios.length === 0 ? (
        <p class="text-stone-600">{t("auth.noStudios")}</p>
      ) : (
        <ul class="card divide-y divide-stone-100 overflow-hidden">
          {studios.map((s) => (
            <li>
              <a href={`/s/${s.slug}`} class="flex items-center gap-3 px-4 py-3.5 hover:bg-stone-50">
                <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-stone-900 text-sm font-bold text-white">
                  {s.name.slice(0, 1).toUpperCase()}
                </span>
                <span class="flex-1 font-medium">{s.name}</span>
                <span class="text-sm text-stone-500">{roleLabel(s.role)}</span>
                <ChevronRight size={16} class="text-stone-300" />
              </a>
            </li>
          ))}
        </ul>
      )}
      <a href="/studios/new" class="btn">
        {t("auth.createStudio")}
      </a>
    </div>
  </Base>
) : (
  <Landing title={`${t("common.appName")} · ${t("site.home.kicker")}`} description={t("site.home.text")}>
    {/* ---------- Hero ---------- */}
    <section class="relative overflow-hidden bg-ink pt-24 pb-32 text-white sm:pt-32 lg:pb-36">
      <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true" />
      <div
        class="pointer-events-none absolute -top-40 right-[-10%] h-[36rem] w-[36rem] rounded-full bg-volt/20 blur-[120px]"
        aria-hidden="true"
      />
      <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-4 sm:px-6 lg:grid-cols-[0.85fr_1.15fr]">
        <div>
          {(notice || problem) && (
            <div class="mb-6 text-sm">
              <Flash message={notice} error={problem} />
            </div>
          )}
          <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs font-semibold tracking-wide text-stone-300 uppercase">
            <Dumbbell size={14} class="text-volt" />
            {t("site.home.kicker")}
          </p>
          <h1 class="font-display text-[3.4rem] leading-[0.88] font-extrabold tracking-tight uppercase sm:text-7xl lg:text-[4.6rem]">
            <span class="block">{t("site.home.titleA")}</span>
            <span class="mt-1 block text-volt">{t("site.home.titleB")}</span>
          </h1>
          <p class="mt-8 max-w-xl text-lg leading-relaxed text-stone-300">{t("site.home.text")}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="/signup?next=/studios/new"
              class="group inline-flex items-center gap-2 rounded-xl bg-volt px-5 py-3 font-semibold text-ink transition hover:bg-white"
            >
              {t("site.home.tryIt")}
              <ArrowRight size={18} class="transition group-hover:translate-x-0.5" />
            </a>
            <button
              type="button"
              data-demo-open
              class="inline-flex items-center gap-2 rounded-xl border border-white/25 px-5 py-3 font-semibold text-white transition hover:border-white hover:bg-white/5"
            >
              <MonitorPlay size={18} />
              {t("site.home.seeDemo")}
            </button>
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-2xl lg:max-w-none xl:mr-[-4rem]">
          <BrowserFrame src={shot("today")} alt={t("site.home.shotAlt")} eager class="lg:rotate-[0.6deg]" />
          <PhoneFrame
            src={shot("phone-home")}
            alt={t("site.home.phoneAlt")}
            eager
            class="absolute -bottom-16 left-1 w-[34%] max-w-[13rem] -rotate-3 sm:-left-10"
          />
          <div class="chip absolute -top-5 right-4 rotate-2">
            <TriangleAlert size={15} class="text-amber-600" />
            {t("site.home.chipLow")}
          </div>
          <div class="chip absolute right-2 bottom-10 -rotate-2 xl:right-[-1.5rem]">
            <Ticket size={15} class="text-ink" />
            {t("site.home.chipLeft")}
          </div>
        </div>
      </div>
    </section>

    {/* ---------- Class types band ---------- */}
    <div class="relative z-10 -mt-6 -rotate-1 overflow-hidden bg-volt py-3 text-ink shadow-lg" aria-hidden="true">
      <div class="marquee flex w-max gap-8 font-display text-2xl font-extrabold tracking-wide uppercase">
        {[...classTypes, ...classTypes, ...classTypes].map((c) => (
          <span class="flex items-center gap-8">
            {c}
            <span class="text-ink/40">✦</span>
          </span>
        ))}
      </div>
    </div>

    {/* ---------- Problems ---------- */}
    <section class="mx-auto max-w-6xl px-4 pt-24 pb-8 sm:px-6">
      <h2 class="font-display text-5xl font-extrabold tracking-tight uppercase sm:text-6xl">
        {t("site.home.painTitle")}
      </h2>
      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {pains.map((p, i) => (
          <div
            class:list={[
              "relative rounded-2xl p-6 transition hover:-translate-y-1",
              i === 0 ? "bg-ink text-white" : "bg-white ring-1 ring-stone-200",
            ]}
          >
            <span
              class:list={[
                "mb-6 flex h-11 w-11 items-center justify-center rounded-xl",
                i === 0 ? "bg-volt text-ink" : "bg-stone-100 text-stone-700",
              ]}
            >
              <p.icon size={22} />
            </span>
            <h3 class="text-xl leading-snug font-semibold">{p.title}</h3>
            <p class:list={["mt-2", i === 0 ? "text-stone-300" : "text-stone-600"]}>{p.text}</p>
          </div>
        ))}
      </div>
    </section>

    {/* ---------- Features ---------- */}
    <section id="features" class="mx-auto max-w-6xl scroll-mt-8 space-y-28 px-4 py-24 sm:px-6 lg:space-y-36">
      <Feature
        eyebrow={t("site.home.packs.eyebrow")}
        title={t("site.home.packs.title")}
        text={t("site.home.packs.text")}
        bullets={[t("site.home.packs.b1"), t("site.home.packs.b2"), t("site.home.packs.b3")]}
        tint="linear-gradient(135deg,#e9f9a8,#d4f53c)"
      >
        <Ticket slot="icon" size={15} />
        <BrowserFrame src={shot("member")} alt={t("site.home.packs.alt")} />
      </Feature>

      <Feature
        eyebrow={t("site.home.booking.eyebrow")}
        title={t("site.home.booking.title")}
        text={t("site.home.booking.text")}
        bullets={[t("site.home.booking.b1"), t("site.home.booking.b2"), t("site.home.booking.b3")]}
        tint="linear-gradient(135deg,#ffd9c2,#ff8a4c)"
        reverse
      >
        <CalendarCheck slot="icon" size={15} />
        <div class="relative">
          <BrowserFrame src={shot("calendar")} alt={t("site.home.booking.alt")} />
          <PhoneFrame
            src={shot("phone-book")}
            alt={t("site.home.booking.alt")}
            class="absolute -right-3 -bottom-14 w-[32%] max-w-[12rem] rotate-3 sm:-right-8"
          />
          <div class="chip absolute -top-5 left-6 -rotate-2">
            <span class="chip-dot bg-emerald-500" />
            {t("site.home.chipBooked")}
          </div>
        </div>
      </Feature>

      <Feature
        eyebrow={t("site.home.members.eyebrow")}
        title={t("site.home.members.title")}
        text={t("site.home.members.text")}
        bullets={[t("site.home.members.b1"), t("site.home.members.b2"), t("site.home.members.b3")]}
        tint="linear-gradient(135deg,#d9e6ff,#7aa2ff)"
      >
        <HeartPulse slot="icon" size={15} />
        <BrowserFrame src={shot("fitness")} alt={t("site.home.members.alt")} />
      </Feature>

      <Feature
        eyebrow={t("site.home.page.eyebrow")}
        title={t("site.home.page.title")}
        text={t("site.home.page.text")}
        tint="linear-gradient(135deg,#e7e5e4,#a8a29e)"
        reverse
      >
        <Globe slot="icon" size={15} />
        <BrowserFrame src={shot("studio-page")} alt={t("site.home.page.alt")} />
      </Feature>
    </section>

    {/* ---------- The question nobody asks anymore ---------- */}
    <section class="relative overflow-hidden bg-ink text-white">
      <div class="hero-grid pointer-events-none absolute inset-0 opacity-60" aria-hidden="true" />
      <div class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
        <h2 class="font-display text-5xl leading-[0.95] font-extrabold tracking-tight uppercase sm:text-7xl lg:text-[5rem]">
          <span class="struck block max-w-5xl text-stone-500">{t("site.home.proof.question")}</span>
          <span class="mt-3 block text-volt">{t("site.home.proof.answer")}</span>
        </h2>
        <div class="mt-10 space-y-7">
          <p class="max-w-xl text-lg leading-relaxed text-stone-300">{t("site.home.proof.text")}</p>
          <ul class="flex flex-col items-start gap-2.5 md:flex-row md:items-center">
            {facts.map((f) => (
              <li class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 text-sm whitespace-nowrap text-stone-200">
                <f.icon size={15} class="text-volt" />
                {f.text}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* ---------- How it works ---------- */}
    <section id="how" class="mx-auto max-w-6xl scroll-mt-8 px-4 py-24 sm:px-6">
      <h2 class="font-display text-5xl font-extrabold tracking-tight uppercase sm:text-6xl">
        {t("site.home.howTitle")}
      </h2>
      <ol class="mt-12 grid gap-6 lg:grid-cols-3">
        {steps.map(([title, text], i) => (
          <li class="relative rounded-2xl bg-white p-6 ring-1 ring-stone-200">
            <span class="font-display text-6xl leading-none font-extrabold text-stone-200">0{i + 1}</span>
            <h3 class="mt-4 text-xl font-semibold">{title}</h3>
            <p class="mt-1.5 text-stone-600">{text}</p>
            {i < 2 && (
              <ArrowRight
                size={22}
                class="absolute top-1/2 -right-5 z-10 hidden -translate-y-1/2 rounded-full bg-volt p-1 text-ink lg:block"
              />
            )}
          </li>
        ))}
      </ol>
    </section>

    {/* ---------- FAQ ---------- */}
    <section id="faq" class="mx-auto max-w-3xl scroll-mt-8 px-4 pb-24 sm:px-6">
      <h2 class="font-display text-5xl font-extrabold tracking-tight uppercase sm:text-6xl">
        {t("site.home.faqTitle")}
      </h2>
      <div class="mt-10 divide-y divide-stone-300/70 border-y border-stone-300/70">
        {faq.map(([q, a]) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold">
              {q}
              <ChevronDown size={20} class="shrink-0 text-stone-400 transition group-open:rotate-180" />
            </summary>
            <p class="mt-3 max-w-2xl text-stone-600">{a}</p>
          </details>
        ))}
      </div>
    </section>

    {/* ---------- Closing call to action ---------- */}
    <section class="px-4 pb-24 sm:px-6">
      <div class="relative mx-auto max-w-6xl overflow-hidden rounded-[2rem] bg-volt px-6 py-14 text-ink sm:px-14">
        <div class="pointer-events-none absolute -right-10 -bottom-16 opacity-[0.12]" aria-hidden="true">
          <Logo markOnly size="lg" class="[&_svg]:h-80 [&_svg]:w-80" />
        </div>
        <h2 class="relative max-w-2xl font-display text-5xl leading-[0.92] font-extrabold tracking-tight uppercase sm:text-7xl">
          {t("site.home.ctaTitle")}
        </h2>
        <p class="relative mt-4 max-w-lg text-lg text-balance">{t("site.home.ctaText")}</p>
        <div class="relative mt-8 flex flex-wrap gap-3">
          <a
            href="/signup?next=/studios/new"
            class="group inline-flex items-center gap-2 rounded-xl bg-ink px-5 py-3 font-semibold text-white transition hover:bg-stone-800"
          >
            {t("site.home.tryIt")}
            <ArrowRight size={18} class="transition group-hover:translate-x-0.5" />
          </a>
          <button
            type="button"
            data-demo-open
            class="inline-flex items-center gap-2 rounded-xl border-2 border-ink px-5 py-2.5 font-semibold transition hover:bg-ink hover:text-white"
          >
            <MonitorPlay size={18} />
            {t("site.home.seeDemo")}
          </button>
        </div>
      </div>
    </section>

    {/* ---------- Demo picker ---------- */}
    <dialog
      id="demo-picker"
      class="demo-picker m-auto w-[min(44rem,calc(100%-2rem))] rounded-3xl bg-white p-0 text-ink shadow-2xl backdrop:bg-ink/70 backdrop:backdrop-blur-sm"
      aria-labelledby="demo-picker-title"
    >
      <div class="relative p-6 sm:p-8">
        <form method="dialog" class="absolute top-4 right-4">
          <button
            class="rounded-lg p-2 text-stone-400 hover:bg-stone-100 hover:text-ink"
            aria-label={t("common.close")}
          >
            <X size={18} />
          </button>
        </form>
        <h2 id="demo-picker-title" class="pr-10 font-display text-4xl font-extrabold tracking-tight uppercase">
          {t("site.home.pickTitle")}
        </h2>
        <p class="mt-2 max-w-lg text-stone-600">{t("site.home.pickText")}</p>
        <form method="post" action="/demo" class="mt-6 grid gap-4 sm:grid-cols-2" data-demo-form>
          {demoViews.map((v) => (
            <button
              name="as"
              value={v.role}
              class="group flex flex-col overflow-hidden rounded-2xl text-left ring-1 ring-stone-200 transition hover:-translate-y-0.5 hover:ring-2 hover:ring-ink focus-visible:ring-2 focus-visible:ring-ink disabled:pointer-events-none disabled:opacity-60"
            >
              <span
                class:list={[
                  "flex h-36 items-start justify-center overflow-hidden px-5 pt-5",
                  v.role === "coach" ? "bg-ink" : "bg-volt",
                ]}
              >
                <Image
                  src={v.shot}
                  alt=""
                  widths={[400, 800]}
                  sizes="20rem"
                  loading="lazy"
                  class:list={[
                    "rounded-t-lg shadow-xl transition group-hover:-translate-y-1",
                    v.role === "coach" ? "h-auto w-full" : "h-auto w-[46%] rounded-t-xl",
                  ]}
                />
              </span>
              <span class="flex flex-1 flex-col p-5">
                <span class="flex items-center justify-between gap-2 text-lg font-semibold">
                  <span class="flex items-center gap-2">
                    <v.icon size={18} />
                    {v.title}
                  </span>
                  <ArrowRight
                    size={18}
                    class="text-stone-400 transition group-hover:translate-x-0.5 group-hover:text-ink"
                  />
                </span>
                <span class="mt-1.5 text-sm text-stone-600">{v.text}</span>
              </span>
            </button>
          ))}
        </form>
        <p class="mt-5 hidden text-sm font-medium text-ink" data-demo-wait aria-live="polite">
          <span class="mr-2 inline-block h-3 w-3 animate-spin rounded-full border-2 border-ink/20 border-t-ink align-[-1px]" />
          {t("site.home.preparing")}
        </p>
        <p class="mt-5 text-sm text-stone-500" data-demo-note>
          {t("site.home.demoNote")}
        </p>
      </div>
    </dialog>
  </Landing>
)}

<style>
  .hero-grid {
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse at 70% 30%, black 20%, transparent 75%);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 9999px;
    background: white;
    padding: 0.5rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #141413;
    box-shadow: 0 12px 30px -8px rgb(0 0 0 / 0.35);
    white-space: nowrap;
  }
  .chip-dot {
    height: 0.5rem;
    width: 0.5rem;
    border-radius: 9999px;
  }
  .struck {
    text-decoration-line: line-through;
    text-decoration-color: var(--color-volt);
    text-decoration-thickness: 0.11em;
  }
  .demo-picker[open] {
    animation: pop 0.18s ease-out;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
  }
  .marquee {
    animation: marquee 40s linear infinite;
  }
  @keyframes marquee {
    to {
      transform: translateX(-33.333%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee,
    .demo-picker[open] {
      animation: none;
    }
  }
</style>

<script>
  const picker = document.querySelector<HTMLDialogElement>("#demo-picker");
  for (const button of document.querySelectorAll("[data-demo-open]")) {
    button.addEventListener("click", () => picker?.showModal());
  }
  // A click on the dimmed backdrop closes the picker.
  picker?.addEventListener("click", (e) => {
    if (e.target === picker && !picker.dataset.busy) picker.close();
  });
  picker?.addEventListener("cancel", (e) => {
    if (picker.dataset.busy) e.preventDefault();
  });

  // Building a demo takes a few seconds: show progress and stop double submits.
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-demo-form]")) {
    form.addEventListener("submit", () => {
      if (picker) picker.dataset.busy = "1";
      // Disabled after the browser has read the pressed button, so its value is still sent.
      setTimeout(() => form.querySelectorAll("button").forEach((b) => (b.disabled = true)));
      document.querySelector("[data-demo-wait]")?.classList.remove("hidden");
      document.querySelector("[data-demo-note]")?.classList.add("hidden");
    });
  }
</script>
