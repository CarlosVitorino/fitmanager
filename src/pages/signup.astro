---
import FormError from "../components/FormError.astro";
import Base from "../layouts/Base.astro";
import { t } from "../i18n";
import { auth } from "../lib/auth";
import { redirectWithCookies, safeNext } from "../server/forms";

const next = safeNext(Astro.url.searchParams.get("next"));
let error: string | null = null;
let name = "";
let email = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  name = String(form.get("name") ?? "").trim();
  email = String(form.get("email") ?? "").trim();
  const res = await auth.api.signUpEmail({
    body: { name, email, password: String(form.get("password") ?? "") },
    headers: Astro.request.headers,
    asResponse: true,
  });
  if (res.ok) return redirectWithCookies(next, res);
  error = t("auth.signupFailed");
  Astro.response.status = res.status;
} else if (Astro.locals.user) {
  return Astro.redirect(next);
}
---

<Base title={t("auth.signupTitle")} narrow>
  <div class="card space-y-6 p-7">
    <h1 class="text-2xl font-semibold tracking-tight">{t("auth.signupTitle")}</h1>
    <FormError message={error} />
    <form method="post" class="space-y-4">
      <label class="block space-y-1">
        <span class="label">{t("auth.fullName")}</span>
        <input name="name" required autocomplete="name" value={name} class="input" />
      </label>
      <label class="block space-y-1">
        <span class="label">{t("common.email")}</span>
        <input name="email" type="email" required autocomplete="email" value={email} class="input" />
      </label>
      <label class="block space-y-1">
        <span class="label">{t("auth.password")}</span>
        <input name="password" type="password" required minlength="8" autocomplete="new-password" class="input" />
        <span class="text-xs text-stone-500">{t("auth.passwordHint")}</span>
      </label>
      <button class="btn btn-primary w-full py-2.5">{t("auth.signupButton")}</button>
    </form>
    <p class="text-sm text-stone-600">
      {t("auth.haveAccount")}{" "}
      <a class="font-medium underline" href={`/login?next=${encodeURIComponent(next)}`}>
        {t("auth.loginButton")}
      </a>
    </p>
  </div>
</Base>
