---
import "../styles/global.css";
import { CalendarDays, CircleUser, CreditCard, House, LogOut, Settings2, Users } from "@lucide/astro";
import Avatar from "../components/Avatar.astro";
import DemoBanner from "../components/DemoBanner.astro";
import Flash from "../components/Flash.astro";
import LanguageMenu from "../components/LanguageMenu.astro";
import { getLocale, t } from "../i18n";
import { isStaff } from "../server/authz";

interface Props {
  title: string;
  flash?: string | null | undefined;
  error?: string | null | undefined;
  wide?: boolean;
}
const { title, flash, error, wide = false } = Astro.props;
const studio = Astro.locals.studio!;
const user = Astro.locals.user!;
const base = `/s/${studio.slug}`;
const staff = isStaff(studio.role);
const path = Astro.url.pathname;
const setup = [
  `${base}/admin/setup`,
  `${base}/admin/plans`,
  `${base}/admin/classes`,
  `${base}/admin/calendars`,
  `${base}/admin/settings`,
  `${base}/admin/page`,
];

const nav = staff
  ? [
      { href: base, label: t("nav.today"), icon: House, exact: true },
      {
        href: `${base}/admin/calendar`,
        label: t("nav.calendar"),
        icon: CalendarDays,
        match: [`${base}/admin/calendar`, `${base}/admin/sessions`],
      },
      { href: `${base}/admin/members`, label: t("nav.members"), icon: Users },
      { href: `${base}/admin/payments`, label: t("nav.payments"), icon: CreditCard },
      { href: `${base}/admin/setup`, label: t("nav.setup"), icon: Settings2, match: setup },
    ]
  : [
      { href: `${base}/me`, label: t("nav.home"), icon: House },
      { href: `${base}/book`, label: t("nav.book"), icon: CalendarDays },
      { href: `${base}/me/profile`, label: t("nav.profile"), icon: CircleUser },
    ];
// The tab whose address matches the current page most specifically is the active one,
// so "/me/profile" lights up "My profile" rather than "Home".
const score = (item: (typeof nav)[number]) => {
  if ("exact" in item && item.exact) return path === item.href || path === `${item.href}/` ? item.href.length : -1;
  const prefixes = "match" in item && item.match ? item.match : [item.href];
  return Math.max(...prefixes.map((h) => (path === h || path.startsWith(`${h}/`) ? h.length : -1)));
};
const best = Math.max(...nav.map(score));
const isActive = (item: (typeof nav)[number]) => best >= 0 && score(item) === best;
const width = wide ? "max-w-7xl" : "max-w-6xl";
---

<!doctype html>
<html lang={getLocale()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · {studio.name}</title>
  </head>
  <body class="min-h-screen font-sans text-stone-900 antialiased">
    <DemoBanner view={staff ? "coach" : "member"} timezone={studio.timezone} width={width} />
    <header class="sticky top-0 z-40 border-b border-stone-200/80 bg-white/90 backdrop-blur">
      <div class:list={["mx-auto flex h-14 items-center gap-6 px-4", width]}>
        <a href={staff ? base : `${base}/me`} class="flex shrink-0 items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-stone-900 text-sm font-bold text-white">
            {studio.name.slice(0, 1).toUpperCase()}
          </span>
          <span class="hidden font-semibold tracking-tight sm:inline">{studio.name}</span>
        </a>
        <nav class="hidden flex-1 items-center gap-1 md:flex">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                "inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-medium transition",
                isActive(item) ? "bg-stone-900 text-white" : "text-stone-600 hover:bg-stone-100 hover:text-stone-900",
              ]}
            >
              <item.icon size={16} />
              {item.label}
            </a>
          ))}
        </nav>
        <div class="ml-auto flex items-center gap-2">
          {staff && (
            <a
              href={`${base}/book`}
              class="hidden rounded-lg px-2.5 py-1.5 text-sm text-stone-500 hover:bg-stone-100 lg:inline"
            >
              {t("common.memberView")}
            </a>
          )}
          <LanguageMenu />
          <span class="flex items-center gap-2 text-sm text-stone-700">
            <Avatar name={user.name} size="sm" />
            <span class="hidden sm:inline">{user.name}</span>
          </span>
          <form method="post" action="/logout">
            <button
              class="rounded-lg p-2 text-stone-500 hover:bg-stone-100 hover:text-stone-900"
              title={t("common.logOut")}
              aria-label={t("common.logOut")}
            >
              <LogOut size={16} />
            </button>
          </form>
        </div>
      </div>
      <nav class="flex gap-1 overflow-x-auto border-t border-stone-100 px-3 py-1.5 md:hidden">
        {nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "inline-flex shrink-0 items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-medium",
              isActive(item) ? "bg-stone-900 text-white" : "text-stone-600",
            ]}
          >
            <item.icon size={15} />
            {item.label}
          </a>
        ))}
      </nav>
    </header>
    <main class:list={["mx-auto px-4 py-8", width]}>
      <Flash message={flash} error={error} />
      <slot />
    </main>
  </body>
</html>
