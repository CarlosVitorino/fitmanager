---
/** Frame for the public home page: dark navigation over the hero, and a footer. */
import "../styles/global.css";
import Logo from "../components/brand/Logo.astro";
import LanguageMenu from "../components/LanguageMenu.astro";
import { getLocale, t } from "../i18n";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={getLocale()} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#141413" />
  </head>
  <body class="min-h-screen bg-[#f4f3ee] font-sans text-stone-900 antialiased">
    <header class="absolute inset-x-0 top-0 z-40">
      <nav class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-4 sm:px-6">
        <a href="/" aria-label={t("common.appName")}>
          <Logo tone="dark" size="sm" />
        </a>
        <div class="hidden flex-1 items-center gap-1 text-sm text-stone-300 md:flex">
          <a href="#features" class="rounded-lg px-3 py-1.5 hover:text-white">
            {t("site.home.navFeatures")}
          </a>
          <a href="#how" class="rounded-lg px-3 py-1.5 hover:text-white">
            {t("site.home.navHow")}
          </a>
          <a href="#faq" class="rounded-lg px-3 py-1.5 hover:text-white">
            {t("site.home.navFaq")}
          </a>
        </div>
        <div class="ml-auto flex items-center gap-1.5 text-sm">
          <LanguageMenu tone="dark" />
          <a
            href="/login"
            class="hidden rounded-lg px-3 py-1.5 font-medium whitespace-nowrap text-white hover:bg-white/10 sm:inline"
          >
            {t("common.logIn")}
          </a>
          <a
            href="/signup?next=/studios/new"
            class="rounded-lg bg-volt px-3.5 py-1.5 font-semibold whitespace-nowrap text-ink transition hover:bg-white"
          >
            {t("site.home.signUp")}
          </a>
        </div>
      </nav>
    </header>
    <main class="overflow-x-clip">
      <slot />
    </main>
    <footer class="bg-ink text-stone-400">
      <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:flex-row sm:items-center sm:px-6">
        <div class="space-y-2">
          <Logo tone="dark" size="sm" />
          <p class="text-sm">{t("site.home.footer")}</p>
        </div>
        <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm sm:ml-auto">
          <a href="#features" class="hover:text-white">
            {t("site.home.navFeatures")}
          </a>
          <a href="#faq" class="hover:text-white">
            {t("site.home.navFaq")}
          </a>
          <a href="/login" class="hover:text-white">
            {t("common.logIn")}
          </a>
          <a href="/signup?next=/studios/new" class="hover:text-white">
            {t("site.home.signUp")}
          </a>
          <span>© {year}</span>
        </div>
      </div>
    </footer>
  </body>
</html>
