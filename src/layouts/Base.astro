---
import "../styles/global.css";
import { LogOut } from "@lucide/astro";
import LanguageMenu from "../components/LanguageMenu.astro";
import { getLocale, t } from "../i18n";

interface Props {
  title: string;
  narrow?: boolean;
  wide?: boolean;
}
const { title, narrow = false, wide = false } = Astro.props;
const width = wide ? "max-w-6xl" : "max-w-5xl";
const { user } = Astro.locals;
---

<!doctype html>
<html lang={getLocale()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {t("common.appName")}</title>
  </head>
  <body class="min-h-screen font-sans text-stone-900 antialiased">
    <header class="border-b border-stone-200/80 bg-white/90">
      <nav class:list={["mx-auto flex h-14 items-center", width, " justify-between gap-4 px-4"]}>
        <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-stone-900 text-sm font-bold text-white">
            F
          </span>
          {t("common.appName")}
        </a>
        <div class="flex items-center gap-2 text-sm">
          <LanguageMenu />
          {user ? (
            <>
              <span class="hidden text-stone-600 sm:inline">{user.name}</span>
              <form method="post" action="/logout">
                <button
                  class="rounded-lg p-2 text-stone-500 hover:bg-stone-100 hover:text-stone-900"
                  title={t("common.logOut")}
                  aria-label={t("common.logOut")}
                >
                  <LogOut size={16} />
                </button>
              </form>
            </>
          ) : (
            <>
              <a href="/login" class="rounded-lg px-3 py-1.5 font-medium hover:bg-stone-100">
                {t("common.logIn")}
              </a>
              <a href="/signup" class="btn btn-sm btn-primary">
                {t("site.home.signUp")}
              </a>
            </>
          )}
        </div>
      </nav>
    </header>
    <main class:list={["mx-auto px-4", narrow ? "max-w-md py-12" : `${width} py-10`]}>
      <slot />
    </main>
  </body>
</html>
