---
interface Props {
  title: string;
  text?: string | undefined;
  compact?: boolean;
}
const { title, text, compact = false } = Astro.props;
---

<div class:list={["flex flex-col items-center text-center", compact ? "py-4" : "py-8"]}>
  <span class="mb-3 flex h-11 w-11 items-center justify-center rounded-full bg-stone-100 text-stone-400">
    <slot name="icon" />
  </span>
  <p class="text-sm font-medium text-stone-700">{title}</p>
  {text && <p class="mt-1 max-w-sm text-sm text-stone-500">{text}</p>}
  <div class="mt-3">
    <slot />
  </div>
</div>
