---
/** Language picker. Links set ?lang=, which the middleware remembers and strips from the address. */
import { Check, Languages } from "@lucide/astro";
import { getLocale, t } from "../i18n";
import { LOCALES, LOCALE_NAMES } from "../i18n/locales";

interface Props {
  align?: "left" | "right";
  /** Background it sits on. */
  tone?: "light" | "dark";
}
const { align = "right", tone = "light" } = Astro.props;
const current = getLocale();
const linkFor = (l: string) => {
  const u = new URL(Astro.url);
  u.searchParams.set("lang", l);
  return u.pathname + u.search;
};
---

<details class="relative">
  <summary
    class:list={[
      "flex cursor-pointer list-none items-center gap-1.5 rounded-lg px-2 py-1.5 text-sm",
      tone === "dark"
        ? "text-stone-300 hover:bg-white/10 hover:text-white"
        : "text-stone-600 hover:bg-stone-100 hover:text-stone-900",
    ]}
    title={t("common.language")}
    aria-label={t("common.language")}
  >
    <Languages size={16} />
    <span class="font-medium uppercase">{current}</span>
  </summary>
  <ul class:list={["card absolute z-50 mt-1 w-44 p-1 text-stone-900", align === "right" ? "right-0" : "left-0"]}>
    {LOCALES.map((l) => (
      <li>
        <a
          href={linkFor(l)}
          lang={l}
          class:list={[
            "flex items-center justify-between rounded-lg px-3 py-2 text-sm hover:bg-stone-100",
            l === current && "font-semibold",
          ]}
        >
          {LOCALE_NAMES[l]}
          {l === current && <Check size={14} />}
        </a>
      </li>
    ))}
  </ul>
</details>
