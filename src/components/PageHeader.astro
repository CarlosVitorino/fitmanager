---
import { ArrowLeft } from "@lucide/astro";

interface Props {
  title: string;
  subtitle?: string | undefined;
  back?: { href: string; label: string } | undefined;
}
const { title, subtitle, back } = Astro.props;
---

<div class="mb-6">
  {back && (
    <a href={back.href} class="mb-2 inline-flex items-center gap-1 text-sm text-stone-500 hover:text-stone-900">
      <ArrowLeft size={14} /> {back.label}
    </a>
  )}
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div class="min-w-0">
      <h1 class="text-2xl font-semibold tracking-tight text-stone-900">{title}</h1>
      {subtitle && <p class="mt-1 text-sm text-stone-500">{subtitle}</p>}
      <slot name="meta" />
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <slot />
    </div>
  </div>
</div>
