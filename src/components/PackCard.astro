---
import { t } from "../i18n";
import { daysBetween, localDateOf } from "../domain/dates";
import { formatDate } from "../lib/format";
import type { PackSummary } from "../server/packs";

interface Props {
  pack: PackSummary;
  timezone: string;
}
const { pack: p, timezone } = Astro.props;
const today = localDateOf(new Date(), timezone);
const total = Math.max(p.total, 1);
const seg = (n: number) => `${(Math.max(n, 0) / total) * 100}%`;
const daysLeft = p.expiresOn ? daysBetween(today, p.expiresOn) : null;
const timePct =
  p.expiresOn && p.status !== "upcoming"
    ? Math.min(
        100,
        Math.max(0, (daysBetween(p.startsOn, today) / Math.max(daysBetween(p.startsOn, p.expiresOn), 1)) * 100),
      )
    : null;
const statusBadge = {
  active: [t("members.pack.active"), "bg-emerald-100 text-emerald-800"],
  used_up: [t("members.pack.usedUp"), "bg-stone-100 text-stone-600"],
  expired: [t("members.pack.expired"), "bg-stone-100 text-stone-600"],
  upcoming: [t("members.pack.upcoming"), "bg-sky-100 text-sky-800"],
}[p.status];
---

<div class:list={["card p-4", (p.status === "expired" || p.status === "used_up") && "opacity-70"]}>
  <div class="flex items-start justify-between gap-2">
    <div>
      <div class="font-semibold">{p.name}</div>
      <div class="muted text-xs">
        {formatDate(p.startsOn)} → {p.expiresOn ? formatDate(p.expiresOn) : t("members.pack.noExpiry")}
        {p.status === "active" &&
          daysLeft !== null &&
          ` · ${daysLeft === 0 ? t("members.pack.lastDay") : t("members.pack.daysLeft", { count: daysLeft })}`}
      </div>
    </div>
    <span class:list={["badge", statusBadge[1]]}>{statusBadge[0]}</span>
  </div>
  <div class="mt-3 flex items-baseline gap-1">
    <span class="text-3xl font-semibold tabular-nums">{p.available}</span>
    <span class="text-sm text-stone-500">{t("members.pack.creditsFree", { total: p.total })}</span>
  </div>
  <div
    class="mt-2 flex h-2.5 overflow-hidden rounded-full bg-stone-100"
    role="img"
    aria-label={`${t("members.pack.used", { count: p.used })}, ${t("members.pack.booked", { count: p.reserved })}, ${t("members.pack.free", { count: p.available })}, ${t("members.pack.expiredCount", { count: p.expired })}`}
  >
    <span class="bg-stone-700" style={`width:${seg(p.used)}`}></span>
    <span class="bg-sky-500" style={`width:${seg(p.reserved)}`}></span>
    <span class="bg-emerald-400" style={`width:${seg(p.available)}`}></span>
    <span class="bg-red-300" style={`width:${seg(p.expired)}`}></span>
  </div>
  <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-stone-600">
    <span>
      <span class="mr-1 inline-block h-2 w-2 rounded-full bg-stone-700"></span>
      {t("members.pack.used", { count: p.used })}
    </span>
    {p.reserved > 0 && (
      <span>
        <span class="mr-1 inline-block h-2 w-2 rounded-full bg-sky-500"></span>
        {t("members.pack.booked", { count: p.reserved })}
      </span>
    )}
    <span>
      <span class="mr-1 inline-block h-2 w-2 rounded-full bg-emerald-400"></span>
      {t("members.pack.free", { count: p.available })}
    </span>
    {p.expired > 0 && (
      <span>
        <span class="mr-1 inline-block h-2 w-2 rounded-full bg-red-300"></span>
        {t("members.pack.expiredCount", { count: p.expired })}
      </span>
    )}
  </div>
  {timePct !== null && p.status === "active" && (
    <div class="mt-3">
      <div class="mb-1 flex justify-between text-xs text-stone-500">
        <span>{t("members.pack.timeUsed")}</span>
        <span>{Math.round(timePct)}%</span>
      </div>
      <div class="h-1.5 overflow-hidden rounded-full bg-stone-100">
        <div class="h-full bg-stone-400" style={`width:${timePct}%`} />
      </div>
    </div>
  )}
  <slot />
</div>
