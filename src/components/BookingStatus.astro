---
import { t } from "../i18n";

interface Props {
  status: "booked" | "cancelled" | "late_cancelled";
  charged: boolean;
  noShow: boolean;
  settled: boolean;
  sessionCancelled?: boolean;
}
const { status, charged, noShow, settled, sessionCancelled = false } = Astro.props;
let label: string;
let cls: string;
if (sessionCancelled) [label, cls] = [t("booking.status.classCancelled"), "bg-stone-100 text-stone-600"];
else if (status === "cancelled") [label, cls] = [t("booking.status.cancelled"), "bg-stone-100 text-stone-600"];
else if (status === "late_cancelled") [label, cls] = [t("booking.status.lateCancel"), "bg-amber-100 text-amber-800"];
else if (!settled) [label, cls] = [t("booking.status.booked"), "bg-sky-100 text-sky-800"];
else if (noShow) [label, cls] = [t("booking.status.noShow"), "bg-amber-100 text-amber-800"];
else [label, cls] = [t("booking.status.attended"), "bg-emerald-100 text-emerald-800"];
const creditNote =
  status === "cancelled" || sessionCancelled
    ? t("booking.status.creditReturned")
    : !charged
      ? t("booking.status.creditWaived")
      : settled || status === "late_cancelled"
        ? t("booking.status.creditUsed")
        : t("booking.status.creditReserved");
---

<span class="inline-flex flex-wrap items-center gap-1.5">
  <span class:list={["badge", cls]}>{label}</span>
  <span class="text-xs text-stone-500">{creditNote}</span>
</span>
