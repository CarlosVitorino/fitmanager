---
/**
 * The fitness profile, read-only. Used on the member's own profile and as the summary on the coach's
 * Fitness tab. Sections the viewer can't see are simply not rendered.
 */
import { Activity, Dumbbell, HeartPulse, Ruler, Target, Trophy } from "@lucide/astro";
import EmptyState from "../EmptyState.astro";
import Section from "../Section.astro";
import Sparkline from "./Sparkline.astro";
import { measurementChange, summariseBenchmarks } from "../../domain/progress";
import { formatDate, formatNumber } from "../../lib/format";
import { t } from "../../i18n";
import { clearanceLabel, experienceLabel, goalLabel, metricLabel, unitLabel } from "../../server/labels";
import type { FitnessProfile } from "../../server/profiles";

interface Props {
  profile: FitnessProfile;
  measurements: {
    measuredOn: string;
    weightKg: number | null;
    bodyFatPct: number | null;
    waistCm: number | null;
    hipsCm: number | null;
    chestCm: number | null;
    armCm: number | null;
    thighCm: number | null;
    restingHr: number | null;
  }[];
  benchmarks: { exercise: string; value: number; unit: string; recordedOn: string }[];
  /** Member view: hide sections that aren't shared instead of showing coach-only content. */
  memberView?: boolean;
}
const { profile: p, measurements, benchmarks, memberView = false } = Astro.props;
const show = (s: keyof FitnessProfile["shared"]) => !memberView || p.shared[s];

const CLEARANCE_CLS = {
  unknown: "bg-stone-100 text-stone-600",
  cleared: "bg-emerald-50 text-emerald-700",
  needs_clearance: "bg-rose-50 text-rose-700",
} as const;
const METRICS = ["weightKg", "bodyFatPct", "waistCm", "hipsCm", "chestCm", "armCm", "thighCm", "restingHr"] as const;
const METRIC_UNITS: Record<(typeof METRICS)[number], string> = {
  weightKg: "kg",
  bodyFatPct: "%",
  waistCm: "cm",
  hipsCm: "cm",
  chestCm: "cm",
  armCm: "cm",
  thighCm: "cm",
  restingHr: "bpm",
};
const changes = METRICS.map((key) => ({
  key,
  label: metricLabel(key),
  unit: METRIC_UNITS[key],
  c: measurementChange(measurements, (r) => r[key]),
})).filter((m) => m.c);
const summary = summariseBenchmarks(benchmarks);
const fmt = (n: number) => formatNumber(n);
const hasGoals = p.goals.length > 0 || p.goalNotes || p.targetDate;
const hasBackground = p.experience || p.trainingNotes;
const hasHealth = p.clearance !== "unknown" || p.injuries || p.medical;
---

<div class="grid gap-5 lg:grid-cols-2">
  {show("goals") && (
    <Section title={t("profile.fitness.goals")}>
      <Target slot="icon" size={18} />
      {hasGoals ? (
        <div class="space-y-3">
          {p.goals.length > 0 && (
            <div class="flex flex-wrap gap-1.5">
              {p.goals.map((g) => (
                <span class="chip">{goalLabel(g)}</span>
              ))}
            </div>
          )}
          {p.goalNotes && <div class="fm-prose" set:html={p.goalNotes} />}
          {p.targetDate && (
            <p class="text-sm text-stone-500">{t("profile.fitness.targetDate", { date: formatDate(p.targetDate) })}</p>
          )}
        </div>
      ) : (
        <EmptyState title={t("profile.fitness.noGoals")} compact>
          <Target slot="icon" size={20} />
        </EmptyState>
      )}
    </Section>
  )}
  {show("background") && (
    <Section title={t("profile.fitness.background")}>
      <Activity slot="icon" size={18} />
      {hasBackground ? (
        <div class="space-y-3">
          {p.experience && <span class="chip">{experienceLabel(p.experience)}</span>}
          {p.trainingNotes && <div class="fm-prose" set:html={p.trainingNotes} />}
        </div>
      ) : (
        <EmptyState title={t("profile.fitness.nothingYet")} compact>
          <Activity slot="icon" size={20} />
        </EmptyState>
      )}
    </Section>
  )}
  {show("health") && (
    <Section title={t("profile.fitness.health")} class="lg:col-span-2">
      <HeartPulse slot="icon" size={18} />
      {hasHealth ? (
        <div class="space-y-3">
          <span class:list={["badge", CLEARANCE_CLS[p.clearance]]}>{clearanceLabel(p.clearance)}</span>
          <div class="grid gap-4 md:grid-cols-2">
            {p.injuries && (
              <div>
                <p class="eyebrow mb-1">{t("profile.fitness.injuries")}</p>
                <div class="fm-prose" set:html={p.injuries} />
              </div>
            )}
            {p.medical && (
              <div>
                <p class="eyebrow mb-1">{t("profile.fitness.medical")}</p>
                <div class="fm-prose" set:html={p.medical} />
              </div>
            )}
          </div>
        </div>
      ) : (
        <EmptyState title={t("profile.fitness.nothingYet")} compact>
          <HeartPulse slot="icon" size={20} />
        </EmptyState>
      )}
    </Section>
  )}
  {show("measurements") && (
    <Section
      title={t("profile.fitness.measurements")}
      description={
        measurements.length
          ? t("profile.fitness.checkins", {
              count: measurements.length,
              date: formatDate(measurements[measurements.length - 1]!.measuredOn),
            })
          : undefined
      }
    >
      <Ruler slot="icon" size={18} />
      {changes.length ? (
        <ul class="divide-y divide-stone-100">
          {changes.map((m) => (
            <li class="flex items-center justify-between gap-3 py-2.5">
              <span class="w-24 text-sm text-stone-600">{m.label}</span>
              <Sparkline points={m.c!.points} />
              <span class="w-20 text-right font-semibold tabular-nums">
                {fmt(m.c!.latest)}
                <span class="text-xs font-normal text-stone-500"> {m.unit}</span>
              </span>
              <span
                class:list={[
                  "w-16 text-right text-xs tabular-nums",
                  m.c!.change === 0 ? "text-stone-400" : "text-stone-600",
                ]}
              >
                {m.c!.points.length > 1 ? `${m.c!.change > 0 ? "+" : ""}${fmt(m.c!.change)}` : "—"}
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState title={t("profile.fitness.noMeasurements")} compact>
          <Ruler slot="icon" size={20} />
        </EmptyState>
      )}
    </Section>
  )}
  {show("benchmarks") && (
    <Section title={t("profile.fitness.records")}>
      <Trophy slot="icon" size={18} />
      {summary.length ? (
        <ul class="divide-y divide-stone-100">
          {summary.map((s) => (
            <li class="flex items-center justify-between gap-3 py-2.5">
              <span class="flex items-center gap-2 text-sm">
                <Dumbbell size={14} class="text-stone-400" />
                {s.exercise}
              </span>
              <span class="text-right">
                <span class="font-semibold tabular-nums">
                  {fmt(s.best.value)} {unitLabel(s.unit)}
                </span>
                <span class="block text-xs text-stone-500">
                  {s.history.length > 1 && s.improvement > 0
                    ? t("profile.fitness.improvedSince", {
                        amount: `${fmt(s.improvement)} ${unitLabel(s.unit)}`,
                        date: formatDate(s.first.recordedOn),
                      })
                    : formatDate(s.best.recordedOn)}
                </span>
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState title={t("profile.fitness.noRecords")} compact>
          <Trophy slot="icon" size={20} />
        </EmptyState>
      )}
    </Section>
  )}
</div>
