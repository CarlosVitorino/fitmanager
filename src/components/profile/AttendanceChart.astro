---
import { t } from "../../i18n";
import { formatDay } from "../../lib/format";

interface Props {
  weeks: { weekStart: string; count: number }[];
}
const { weeks } = Astro.props;
// Scale to at least 3 a week so one class doesn't look like a full bar.
const max = Math.max(3, ...weeks.map((w) => w.count));
const total = weeks.reduce((n, w) => n + w.count, 0);
---

<div>
  <div
    class="flex h-28 items-end gap-1.5"
    role="img"
    aria-label={t("members.chart.aria", { count: total, weeks: weeks.length })}
  >
    {weeks.map((w, i) => (
      <div class="group relative flex h-full flex-1 flex-col items-center justify-end">
        {w.count > 0 && <span class="mb-1 text-[11px] font-medium text-stone-500 tabular-nums">{w.count}</span>}
        <div
          class:list={[
            "w-full max-w-10 rounded-md transition-all",
            w.count ? (i === weeks.length - 1 ? "bg-stone-900" : "bg-stone-700/80") : "bg-stone-100",
          ]}
          style={`height:${w.count ? Math.max(14, (w.count / max) * 85) : 5}%`}
        />
        <span class="pointer-events-none absolute -top-6 left-1/2 hidden -translate-x-1/2 rounded bg-stone-900 px-1.5 py-0.5 text-[10px] whitespace-nowrap text-white group-hover:block">
          {t("members.chart.weekOf", { count: w.count, date: formatDay(w.weekStart) })}
        </span>
      </div>
    ))}
  </div>
  <div class="mt-1.5 flex justify-between text-[11px] text-stone-400">
    <span>{formatDay(weeks[0]!.weekStart)}</span>
    <span>{t("members.chart.thisWeek")}</span>
  </div>
</div>
