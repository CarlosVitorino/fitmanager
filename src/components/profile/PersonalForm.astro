---
import { t } from "../../i18n";
import DateInput from "../DateInput.astro";

interface Props {
  p: {
    name: string;
    email: string;
    phone: string | null;
    dateOfBirth: string | null;
    gender: string | null;
    addressLine: string | null;
    city: string | null;
    postalCode: string | null;
    country: string | null;
    emergencyName: string | null;
    emergencyPhone: string | null;
  };
  today: string;
  redirect?: string;
}
const { p, today, redirect } = Astro.props;
const field = "block space-y-1";
---

<form method="post" class="space-y-6">
  <input type="hidden" name="_action" value="personal" />
  {redirect && <input type="hidden" name="_redirect" value={redirect} />}
  <fieldset class="grid gap-4 sm:grid-cols-2">
    <legend class="eyebrow mb-3">{t("profile.personal.about")}</legend>
    <label class={field}>
      <span class="label">{t("profile.personal.fullName")}</span>
      <input name="name" required class="input" value={p.name} autocomplete="name" />
    </label>
    <label class={field}>
      <span class="label">{t("common.email")}</span>
      <input class="input bg-stone-50 text-stone-500" value={p.email} disabled />
    </label>
    <label class={field}>
      <span class="label">{t("common.phone")}</span>
      <input name="phone" class="input" value={p.phone ?? ""} autocomplete="tel" inputmode="tel" />
    </label>
    <div class={field}>
      <span class="label">{t("profile.personal.dateOfBirth")}</span>
      <DateInput
        name="dateOfBirth"
        value={p.dateOfBirth}
        today={today}
        optional
        placeholder={t("common.notSet")}
        ariaLabel={t("profile.personal.dateOfBirth")}
      />
    </div>
    <label class={field}>
      <span class="label">{t("profile.personal.gender")}</span>
      <input
        name="gender"
        class="input"
        value={p.gender ?? ""}
        list="gender-options"
        placeholder={t("common.optional")}
      />
      <datalist id="gender-options">
        <option value={t("profile.personal.genderFemale")} />
        <option value={t("profile.personal.genderMale")} />
        <option value={t("profile.personal.genderNonBinary")} />
        <option value={t("profile.personal.genderUnsaid")} />
      </datalist>
    </label>
  </fieldset>
  <fieldset class="grid gap-4 sm:grid-cols-2">
    <legend class="eyebrow mb-3">{t("profile.personal.address")}</legend>
    <label class:list={[field, "sm:col-span-2"]}>
      <span class="label">{t("profile.personal.street")}</span>
      <input name="addressLine" class="input" value={p.addressLine ?? ""} autocomplete="street-address" />
    </label>
    <label class={field}>
      <span class="label">{t("profile.personal.city")}</span>
      <input name="city" class="input" value={p.city ?? ""} autocomplete="address-level2" />
    </label>
    <label class={field}>
      <span class="label">{t("profile.personal.postalCode")}</span>
      <input name="postalCode" class="input" value={p.postalCode ?? ""} autocomplete="postal-code" />
    </label>
    <label class={field}>
      <span class="label">{t("profile.personal.country")}</span>
      <input name="country" class="input" value={p.country ?? ""} autocomplete="country-name" />
    </label>
  </fieldset>
  <fieldset class="grid gap-4 sm:grid-cols-2">
    <legend class="eyebrow mb-3">{t("profile.personal.emergency")}</legend>
    <label class={field}>
      <span class="label">{t("common.name")}</span>
      <input name="emergencyName" class="input" value={p.emergencyName ?? ""} />
    </label>
    <label class={field}>
      <span class="label">{t("common.phone")}</span>
      <input name="emergencyPhone" class="input" value={p.emergencyPhone ?? ""} inputmode="tel" />
    </label>
  </fieldset>
  <div class="flex items-center gap-3">
    <button class="btn btn-primary">{t("profile.personal.save")}</button>
    <span class="text-xs text-stone-500">{t("profile.personal.allOptional")}</span>
  </div>
</form>
