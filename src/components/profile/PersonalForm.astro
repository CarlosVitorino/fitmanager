---
import DateField from "../islands/DateField";

interface Props {
  p: {
    name: string;
    email: string;
    phone: string | null;
    dateOfBirth: string | null;
    gender: string | null;
    addressLine: string | null;
    city: string | null;
    postalCode: string | null;
    country: string | null;
    emergencyName: string | null;
    emergencyPhone: string | null;
  };
  today: string;
  redirect?: string;
}
const { p, today, redirect } = Astro.props;
const field = "block space-y-1";
---

<form method="post" class="space-y-6">
  <input type="hidden" name="_action" value="personal" />
  {redirect && <input type="hidden" name="_redirect" value={redirect} />}
  <fieldset class="grid gap-4 sm:grid-cols-2">
    <legend class="eyebrow mb-3">About</legend>
    <label class={field}>
      <span class="label">Full name</span>
      <input name="name" required class="input" value={p.name} autocomplete="name" />
    </label>
    <label class={field}>
      <span class="label">Email</span>
      <input class="input bg-stone-50 text-stone-500" value={p.email} disabled />
    </label>
    <label class={field}>
      <span class="label">Phone</span>
      <input name="phone" class="input" value={p.phone ?? ""} autocomplete="tel" inputmode="tel" />
    </label>
    <div class={field}>
      <span class="label">Date of birth</span>
      <DateField
        client:load
        name="dateOfBirth"
        value={p.dateOfBirth}
        today={today}
        optional
        placeholder="Not set"
        ariaLabel="Date of birth"
      />
    </div>
    <label class={field}>
      <span class="label">Gender</span>
      <input name="gender" class="input" value={p.gender ?? ""} list="gender-options" placeholder="Optional" />
      <datalist id="gender-options">
        <option value="Female" />
        <option value="Male" />
        <option value="Non-binary" />
        <option value="Prefer not to say" />
      </datalist>
    </label>
  </fieldset>
  <fieldset class="grid gap-4 sm:grid-cols-2">
    <legend class="eyebrow mb-3">Address</legend>
    <label class:list={[field, "sm:col-span-2"]}>
      <span class="label">Street</span>
      <input name="addressLine" class="input" value={p.addressLine ?? ""} autocomplete="street-address" />
    </label>
    <label class={field}>
      <span class="label">City</span>
      <input name="city" class="input" value={p.city ?? ""} autocomplete="address-level2" />
    </label>
    <label class={field}>
      <span class="label">Postal code</span>
      <input name="postalCode" class="input" value={p.postalCode ?? ""} autocomplete="postal-code" />
    </label>
    <label class={field}>
      <span class="label">Country</span>
      <input name="country" class="input" value={p.country ?? ""} autocomplete="country-name" />
    </label>
  </fieldset>
  <fieldset class="grid gap-4 sm:grid-cols-2">
    <legend class="eyebrow mb-3">Emergency contact</legend>
    <label class={field}>
      <span class="label">Name</span>
      <input name="emergencyName" class="input" value={p.emergencyName ?? ""} />
    </label>
    <label class={field}>
      <span class="label">Phone</span>
      <input name="emergencyPhone" class="input" value={p.emergencyPhone ?? ""} inputmode="tel" />
    </label>
  </fieldset>
  <div class="flex items-center gap-3">
    <button class="btn btn-primary">Save details</button>
    <span class="text-xs text-stone-500">Everything is optional.</span>
  </div>
</form>
