---
import { t } from "../../i18n";
import { Plus, Trash } from "@lucide/astro";
import DateInput from "../DateInput.astro";
import { formatDate } from "../../lib/format";

interface Props {
  rows: {
    id: string;
    measuredOn: string;
    weightKg: number | null;
    bodyFatPct: number | null;
    waistCm: number | null;
    hipsCm: number | null;
    chestCm: number | null;
    armCm: number | null;
    thighCm: number | null;
    restingHr: number | null;
    note: string | null;
  }[];
  today: string;
}
const { rows, today } = Astro.props;
const COLS = [
  ["weightKg", t("profile.metrics.weightKg"), "kg"],
  ["bodyFatPct", t("profile.metrics.bodyFatPct"), "%"],
  ["waistCm", t("profile.metrics.waistCm"), "cm"],
  ["hipsCm", t("profile.metrics.hipsCm"), "cm"],
  ["chestCm", t("profile.metrics.chestCm"), "cm"],
  ["armCm", t("profile.metrics.armCm"), "cm"],
  ["thighCm", t("profile.metrics.thighCm"), "cm"],
  ["restingHr", t("profile.checkin.restHr"), "bpm"],
] as const;
const newestFirst = [...rows].reverse();
---

<details class="group">
  <summary class="btn btn-sm list-none">
    <Plus size={14} /> {t("profile.checkin.add")}
  </summary>
  <form method="post" class="mt-3 rounded-xl border border-stone-200 bg-stone-50 p-4">
    <input type="hidden" name="_action" value="measurement" />
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="col-span-2 space-y-1">
        <span class="label">{t("common.date")}</span>
        <DateInput name="measuredOn" value={today} today={today} required ariaLabel={t("common.date")} />
      </div>
      {COLS.map(([k, l, u]) => (
        <label class="block space-y-1">
          <span class="label">
            {l} <span class="font-normal text-stone-400">{u}</span>
          </span>
          <input name={k} inputmode="decimal" class="input" />
        </label>
      ))}
      <label class="col-span-2 block space-y-1 sm:col-span-4">
        <span class="label">{t("common.note")}</span>
        <input name="note" class="input" placeholder={t("profile.checkin.notePlaceholder")} />
      </label>
    </div>
    <button class="btn btn-primary mt-3">{t("profile.checkin.save")}</button>
  </form>
</details>

{rows.length > 0 && (
  <div class="mt-4 overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <th>{t("common.date")}</th>
          {COLS.map(([, l]) => (
            <th class="text-right">{l}</th>
          ))}
          <th />
        </tr>
      </thead>
      <tbody>
        {newestFirst.map((r) => (
          <tr>
            <td class="whitespace-nowrap">
              {formatDate(r.measuredOn)}
              {r.note && <span class="block text-xs text-stone-500">{r.note}</span>}
            </td>
            {COLS.map(([k]) => (
              <td class="text-right tabular-nums">{r[k] ?? <span class="text-stone-300">—</span>}</td>
            ))}
            <td class="text-right">
              <form method="post">
                <input type="hidden" name="_action" value="deleteMeasurement" />
                <input type="hidden" name="id" value={r.id} />
                <button
                  class="rounded p-1 text-stone-400 hover:bg-red-50 hover:text-red-600"
                  aria-label={t("profile.checkin.delete")}
                  onclick={`return confirm(${JSON.stringify(t("profile.checkin.deleteConfirm"))})`}
                >
                  <Trash size={14} />
                </button>
              </form>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
