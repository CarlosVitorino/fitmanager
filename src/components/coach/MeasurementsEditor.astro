---
import { Plus, Trash } from "@lucide/astro";
import DateField from "../islands/DateField";
import { formatDate } from "../../lib/format";

interface Props {
  rows: {
    id: string;
    measuredOn: string;
    weightKg: number | null;
    bodyFatPct: number | null;
    waistCm: number | null;
    hipsCm: number | null;
    chestCm: number | null;
    armCm: number | null;
    thighCm: number | null;
    restingHr: number | null;
    note: string | null;
  }[];
  today: string;
}
const { rows, today } = Astro.props;
const COLS = [
  ["weightKg", "Weight", "kg"],
  ["bodyFatPct", "Body fat", "%"],
  ["waistCm", "Waist", "cm"],
  ["hipsCm", "Hips", "cm"],
  ["chestCm", "Chest", "cm"],
  ["armCm", "Arm", "cm"],
  ["thighCm", "Thigh", "cm"],
  ["restingHr", "Rest HR", "bpm"],
] as const;
const newestFirst = [...rows].reverse();
---

<details class="group">
  <summary class="btn btn-sm list-none">
    <Plus size={14} /> Add a check-in
  </summary>
  <form method="post" class="mt-3 rounded-xl border border-stone-200 bg-stone-50 p-4">
    <input type="hidden" name="_action" value="measurement" />
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="col-span-2 space-y-1">
        <span class="label">Date</span>
        <DateField client:load name="measuredOn" value={today} today={today} required ariaLabel="Measured on" />
      </div>
      {COLS.map(([k, l, u]) => (
        <label class="block space-y-1">
          <span class="label">
            {l} <span class="font-normal text-stone-400">{u}</span>
          </span>
          <input name={k} inputmode="decimal" class="input" />
        </label>
      ))}
      <label class="col-span-2 block space-y-1 sm:col-span-4">
        <span class="label">Note</span>
        <input name="note" class="input" placeholder="Optional, e.g. after holidays" />
      </label>
    </div>
    <button class="btn btn-primary mt-3">Save check-in</button>
  </form>
</details>

{rows.length > 0 && (
  <div class="mt-4 overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <th>Date</th>
          {COLS.map(([, l]) => (
            <th class="text-right">{l}</th>
          ))}
          <th />
        </tr>
      </thead>
      <tbody>
        {newestFirst.map((r) => (
          <tr>
            <td class="whitespace-nowrap">
              {formatDate(r.measuredOn)}
              {r.note && <span class="block text-xs text-stone-500">{r.note}</span>}
            </td>
            {COLS.map(([k]) => (
              <td class="text-right tabular-nums">{r[k] ?? <span class="text-stone-300">—</span>}</td>
            ))}
            <td class="text-right">
              <form method="post">
                <input type="hidden" name="_action" value="deleteMeasurement" />
                <input type="hidden" name="id" value={r.id} />
                <button
                  class="rounded p-1 text-stone-400 hover:bg-red-50 hover:text-red-600"
                  aria-label="Delete check-in"
                  onclick="return confirm('Delete this check-in?')"
                >
                  <Trash size={14} />
                </button>
              </form>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
