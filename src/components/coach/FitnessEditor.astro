---
import { Activity, HeartPulse, Target } from "@lucide/astro";
import DateField from "../islands/DateField";
import RichTextEditor from "../islands/RichTextEditor";
import { GOALS, type FitnessProfile } from "../../server/profiles";

interface Props {
  p: FitnessProfile;
  today: string;
}
const { p, today } = Astro.props;
const custom = p.goals.filter((g) => !(GOALS as readonly string[]).includes(g));
const EXPERIENCE = [
  ["new", "New to training"],
  ["some", "Some experience"],
  ["regular", "Trains regularly"],
  ["advanced", "Advanced"],
] as const;
const CLEARANCE = [
  ["unknown", "Not checked yet", "Health questionnaire not done."],
  ["cleared", "Cleared to train", "No issues, or a doctor has cleared them."],
  ["needs_clearance", "Needs medical clearance", "Ask for a doctor's OK before training hard."],
] as const;
---

<form method="post" class="space-y-6">
  <input type="hidden" name="_action" value="fitness" />

  <section class="card p-5">
    <h3 class="h2 mb-4 flex items-center gap-2">
      <Target size={18} class="text-stone-400" /> Goals
    </h3>
    <div class="flex flex-wrap gap-2">
      {GOALS.map((g) => (
        <label class="cursor-pointer">
          <input type="checkbox" name="goals" value={g} checked={p.goals.includes(g)} class="peer sr-only" />
          <span class="inline-flex items-center rounded-full border border-stone-300 bg-white px-3 py-1.5 text-sm text-stone-700 transition peer-checked:border-stone-900 peer-checked:bg-stone-900 peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-stone-300">
            {g}
          </span>
        </label>
      ))}
    </div>
    <label class="mt-3 block space-y-1">
      <span class="label">
        Other goals <span class="font-normal text-stone-400">(comma separated)</span>
      </span>
      <input
        name="otherGoals"
        class="input"
        value={custom.join(", ")}
        placeholder="e.g. First pull-up, Hike Kilimanjaro"
      />
    </label>
    <div class="mt-4 grid gap-4 md:grid-cols-[1fr_14rem]">
      <div class="space-y-1">
        <span class="label">What they want to achieve</span>
        <RichTextEditor
          client:load
          name="goalNotes"
          value={p.goalNotes}
          placeholder="Their own words, the why, and how you'll measure it…"
          minHeight={6}
          ariaLabel="Goal details"
        />
      </div>
      <div class="space-y-1">
        <span class="label">Target date</span>
        <DateField
          client:load
          name="targetDate"
          value={p.targetDate}
          today={today}
          optional
          placeholder="No target date"
          ariaLabel="Target date"
        />
      </div>
    </div>
  </section>

  <section class="card p-5">
    <h3 class="h2 mb-4 flex items-center gap-2">
      <Activity size={18} class="text-stone-400" /> Training background
    </h3>
    <div class="flex flex-wrap gap-2">
      {EXPERIENCE.map(([v, l]) => (
        <label class="cursor-pointer">
          <input type="radio" name="experience" value={v} checked={p.experience === v} class="peer sr-only" />
          <span class="inline-flex rounded-lg border border-stone-300 bg-white px-3 py-1.5 text-sm text-stone-700 transition peer-checked:border-stone-900 peer-checked:bg-stone-900 peer-checked:text-white">
            {l}
          </span>
        </label>
      ))}
    </div>
    <div class="mt-4 space-y-1">
      <span class="label">History, sports, what's worked before, preferences</span>
      <RichTextEditor
        client:load
        name="trainingNotes"
        value={p.trainingNotes}
        placeholder="Played football until 25, hates running, prefers mornings…"
        minHeight={6}
        ariaLabel="Training background"
      />
    </div>
  </section>

  <section class="card p-5">
    <h3 class="h2 mb-4 flex items-center gap-2">
      <HeartPulse size={18} class="text-stone-400" /> Health & injuries
    </h3>
    <div class="grid gap-2 sm:grid-cols-3">
      {CLEARANCE.map(([v, l, d]) => (
        <label class="cursor-pointer">
          <input type="radio" name="clearance" value={v} checked={p.clearance === v} class="peer sr-only" />
          <span class="block h-full rounded-xl border border-stone-300 bg-white p-3 transition peer-checked:border-stone-900 peer-checked:ring-1 peer-checked:ring-stone-900">
            <span class="block text-sm font-medium">{l}</span>
            <span class="block text-xs text-stone-500">{d}</span>
          </span>
        </label>
      ))}
    </div>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      <div class="space-y-1">
        <span class="label">Injuries & limitations</span>
        <RichTextEditor
          client:load
          name="injuries"
          value={p.injuries}
          placeholder="Old injuries, pain, movements to avoid…"
          minHeight={6}
          ariaLabel="Injuries and limitations"
        />
      </div>
      <div class="space-y-1">
        <span class="label">Medical conditions & medication</span>
        <RichTextEditor
          client:load
          name="medical"
          value={p.medical}
          placeholder="Asthma, blood pressure, pregnancy, medication…"
          minHeight={6}
          ariaLabel="Medical conditions"
        />
      </div>
    </div>
  </section>

  <div class="sticky bottom-4 z-10 -mt-2 flex justify-end">
    <button class="btn btn-primary shadow-lg">Save fitness profile</button>
  </div>
</form>
