---
import { t } from "../../i18n";
import { experienceLabel, goalLabel } from "../../server/labels";
import { Activity, HeartPulse, Target } from "@lucide/astro";
import DateInput from "../DateInput.astro";
import RichText from "../RichText.astro";
import { GOALS, type FitnessProfile } from "../../server/profiles";

interface Props {
  p: FitnessProfile;
  today: string;
}
const { p, today } = Astro.props;
const custom = p.goals.filter((g) => !(GOALS as readonly string[]).includes(g));
const EXPERIENCE = ["new", "some", "regular", "advanced"] as const;
const CLEARANCE = [
  ["unknown", t("profile.clearance.unknownShort"), t("profile.clearance.unknownHint")],
  ["cleared", t("profile.clearance.cleared"), t("profile.clearance.clearedHint")],
  ["needs_clearance", t("profile.clearance.needs_clearance"), t("profile.clearance.needsHint")],
] as const;
---

<form method="post" class="space-y-6">
  <input type="hidden" name="_action" value="fitness" />

  <section class="card p-5">
    <h3 class="h2 mb-4 flex items-center gap-2">
      <Target size={18} class="text-stone-400" /> {t("profile.fitness.goals")}
    </h3>
    <div class="flex flex-wrap gap-2">
      {GOALS.map((g) => (
        <label class="cursor-pointer">
          <input type="checkbox" name="goals" value={g} checked={p.goals.includes(g)} class="peer sr-only" />
          <span class="inline-flex items-center rounded-full border border-stone-300 bg-white px-3 py-1.5 text-sm text-stone-700 transition peer-checked:border-stone-900 peer-checked:bg-stone-900 peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-stone-300">
            {goalLabel(g)}
          </span>
        </label>
      ))}
    </div>
    <label class="mt-3 block space-y-1">
      <span class="label">
        {t("profile.fitness.otherGoals")}{" "}
        <span class="font-normal text-stone-400">({t("profile.fitness.otherGoalsHint")})</span>
      </span>
      <input
        name="otherGoals"
        class="input"
        value={custom.join(", ")}
        placeholder={t("profile.fitness.otherGoalsPlaceholder")}
      />
    </label>
    <div class="mt-4 grid gap-4 md:grid-cols-[1fr_14rem]">
      <div class="space-y-1">
        <span class="label">{t("profile.fitness.wantToAchieve")}</span>
        <RichText
          name="goalNotes"
          value={p.goalNotes}
          placeholder={t("profile.fitness.wantPlaceholder")}
          minHeight={6}
          ariaLabel={t("profile.fitness.wantToAchieve")}
        />
      </div>
      <div class="space-y-1">
        <span class="label">{t("profile.fitness.targetDateLabel")}</span>
        <DateInput
          name="targetDate"
          value={p.targetDate}
          today={today}
          optional
          placeholder={t("profile.fitness.noTargetDate")}
          ariaLabel={t("profile.fitness.targetDateLabel")}
        />
      </div>
    </div>
  </section>

  <section class="card p-5">
    <h3 class="h2 mb-4 flex items-center gap-2">
      <Activity size={18} class="text-stone-400" /> {t("profile.fitness.background")}
    </h3>
    <div class="flex flex-wrap gap-2">
      {EXPERIENCE.map((v) => (
        <label class="cursor-pointer">
          <input type="radio" name="experience" value={v} checked={p.experience === v} class="peer sr-only" />
          <span class="inline-flex rounded-lg border border-stone-300 bg-white px-3 py-1.5 text-sm text-stone-700 transition peer-checked:border-stone-900 peer-checked:bg-stone-900 peer-checked:text-white">
            {experienceLabel(v)}
          </span>
        </label>
      ))}
    </div>
    <div class="mt-4 space-y-1">
      <span class="label">{t("profile.fitness.historyLabel")}</span>
      <RichText
        name="trainingNotes"
        value={p.trainingNotes}
        placeholder={t("profile.fitness.historyPlaceholder")}
        minHeight={6}
        ariaLabel={t("profile.fitness.background")}
      />
    </div>
  </section>

  <section class="card p-5">
    <h3 class="h2 mb-4 flex items-center gap-2">
      <HeartPulse size={18} class="text-stone-400" /> {t("profile.fitness.health")}
    </h3>
    <div class="grid gap-2 sm:grid-cols-3">
      {CLEARANCE.map(([v, l, d]) => (
        <label class="cursor-pointer">
          <input type="radio" name="clearance" value={v} checked={p.clearance === v} class="peer sr-only" />
          <span class="block h-full rounded-xl border border-stone-300 bg-white p-3 transition peer-checked:border-stone-900 peer-checked:ring-1 peer-checked:ring-stone-900">
            <span class="block text-sm font-medium">{l}</span>
            <span class="block text-xs text-stone-500">{d}</span>
          </span>
        </label>
      ))}
    </div>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      <div class="space-y-1">
        <span class="label">{t("profile.fitness.injuries")}</span>
        <RichText
          name="injuries"
          value={p.injuries}
          placeholder={t("profile.fitness.injuriesPlaceholder")}
          minHeight={6}
          ariaLabel={t("profile.fitness.injuries")}
        />
      </div>
      <div class="space-y-1">
        <span class="label">{t("profile.fitness.medical")}</span>
        <RichText
          name="medical"
          value={p.medical}
          placeholder={t("profile.fitness.medicalPlaceholder")}
          minHeight={6}
          ariaLabel={t("profile.fitness.medical")}
        />
      </div>
    </div>
  </section>

  <div class="sticky bottom-4 z-10 -mt-2 flex justify-end">
    <button class="btn btn-primary shadow-lg">{t("profile.fitness.save")}</button>
  </div>
</form>
