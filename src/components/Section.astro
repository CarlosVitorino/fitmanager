---
interface Props {
  title?: string;
  description?: string | undefined;
  class?: string;
  id?: string;
  padded?: boolean;
}
const { title, description, class: className, id, padded = true } = Astro.props;
---

<section id={id} class:list={["card", padded && "p-5", className]}>
  {(title || Astro.slots.has("actions")) && (
    <div class:list={["flex flex-wrap items-start justify-between gap-2", padded ? "mb-4" : "px-5 pt-5 pb-3"]}>
      <div class="flex items-start gap-2.5">
        {Astro.slots.has("icon") && (
          <span class="mt-0.5 text-stone-400">
            <slot name="icon" />
          </span>
        )}
        <div>
          {title && <h2 class="h2">{title}</h2>}
          {description && <p class="muted mt-0.5">{description}</p>}
        </div>
      </div>
      <slot name="actions" />
    </div>
  )}
  <slot />
</section>
