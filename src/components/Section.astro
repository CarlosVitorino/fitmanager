---
interface Props {
  title: string;
  description?: string;
  class?: string;
}
const { title, description, class: className } = Astro.props;
---

<section class:list={["card p-5", className]}>
  <div class="mb-4 flex flex-wrap items-start justify-between gap-2">
    <div>
      <h2 class="h2">{title}</h2>
      {description && <p class="muted mt-0.5">{description}</p>}
    </div>
    <slot name="actions" />
  </div>
  <slot />
</section>
