---
import { t } from "../../i18n";

interface Props {
  plan?: {
    name: string;
    description: string | null;
    entries: number;
    validityUnit: string | null;
    validityAmount: number | null;
    priceCents: number | null;
  };
  currency: string;
}
const { plan, currency } = Astro.props;
const units = [
  ["days", t("setup.plans.unitDays")],
  ["weeks", t("setup.plans.unitWeeks")],
  ["months", t("setup.plans.unitMonths")],
  ["never", t("setup.plans.unitNever")],
] as const;
---

<label class="block space-y-1">
  <span class="label">{t("setup.plans.nameLabel")}</span>
  <input name="name" required class="input" value={plan?.name ?? ""} placeholder={t("setup.plans.namePlaceholder")} />
</label>
<label class="block space-y-1">
  <span class="label">
    {t("setup.plans.descriptionLabel")}{" "}
    <span class="font-normal text-stone-400">({t("setup.plans.descriptionHint")})</span>
  </span>
  <input name="description" class="input" value={plan?.description ?? ""} />
</label>
<div class="grid grid-cols-2 gap-3">
  <label class="block space-y-1">
    <span class="label">{t("setup.plans.classesLabel")}</span>
    <input name="entries" type="number" min="1" required class="input" value={plan?.entries ?? 10} />
  </label>
  <label class="block space-y-1">
    <span class="label">{t("setup.plans.priceLabel", { currency })}</span>
    <input
      name="price"
      inputmode="decimal"
      class="input"
      placeholder={t("setup.plans.priceOptional")}
      value={plan?.priceCents != null ? (plan.priceCents / 100).toFixed(2) : ""}
    />
  </label>
</div>
<div class="space-y-1">
  <span class="label">{t("setup.plans.validFor")}</span>
  <div class="grid grid-cols-2 gap-3">
    <input
      name="validityAmount"
      type="number"
      min="1"
      class="input"
      value={plan ? (plan.validityAmount ?? "") : 14}
      aria-label={t("setup.plans.validFor")}
    />
    <select name="validityUnit" class="input" aria-label={t("setup.plans.validFor")}>
      {units.map(([v, l]) => (
        <option value={v} selected={(plan ? (plan.validityUnit ?? "never") : "weeks") === v}>
          {l}
        </option>
      ))}
    </select>
  </div>
  <p class="text-xs text-stone-500">{t("setup.plans.validityHint")}</p>
</div>
