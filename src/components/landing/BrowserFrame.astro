---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  eager?: boolean;
  class?: string;
}
const { src, alt, eager = false, class: className } = Astro.props;
---

<figure
  class:list={[
    "overflow-hidden rounded-xl bg-white shadow-[0_30px_80px_-20px_rgb(0_0_0/0.45)] ring-1 ring-black/10",
    className,
  ]}
>
  <div class="flex items-center gap-1.5 border-b border-stone-200 bg-stone-100 px-3 py-2" aria-hidden="true">
    <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
    <span class="ml-3 h-4 flex-1 rounded bg-white/80 ring-1 ring-stone-200"></span>
  </div>
  <Image
    src={src}
    alt={alt}
    widths={[800, 1200, 1600]}
    sizes="(min-width: 1024px) 720px, 100vw"
    loading={eager ? "eager" : "lazy"}
    class="block h-auto w-full"
  />
</figure>
