---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  eager?: boolean;
  class?: string;
}
const { src, alt, eager = false, class: className } = Astro.props;
---

<figure
  class:list={[
    "rounded-[2.2rem] bg-ink p-2 shadow-[0_30px_60px_-15px_rgb(0_0_0/0.55)] ring-1 ring-white/15",
    className,
  ]}
>
  <div class="relative overflow-hidden rounded-[1.7rem] bg-white">
    <span class="absolute top-2 left-1/2 z-10 h-4 w-16 -translate-x-1/2 rounded-full bg-ink" aria-hidden="true"></span>
    <Image
      src={src}
      alt={alt}
      widths={[390, 780]}
      sizes="260px"
      loading={eager ? "eager" : "lazy"}
      class="block aspect-[390/700] h-auto w-full object-cover object-top"
    />
  </div>
</figure>
